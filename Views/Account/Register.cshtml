@model RegisterViewModel
@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Ký - Aquar SmashCourt</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --primary-color: #10b981;
            --primary-hover: #059669;
            --accent-blue: #3b82f6;
            --bg-gradient: radial-gradient(circle at 10% 20%, rgba(16, 185, 129, 0.18) 0%, transparent 45%), radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.18) 0%, transparent 45%), #f8fafc;
            --glass-bg: rgba(255, 255, 255, 0.85);
            --glass-border: rgba(226, 232, 240, 0.9);
        }

        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient court lines in the body background */
        .ambient-court-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.35;
        }

        .register-wrapper {
            width: 100%;
            max-width: 1000px;
            display: grid;
            grid-template-columns: 1.15fr 1.25fr;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: 0 25px 60px rgba(15, 23, 42, 0.12);
            overflow: hidden;
            z-index: 1;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @@media (max-width: 991px) {
            .register-wrapper {
                grid-template-columns: 1fr;
                max-width: 500px;
            }

            .brand-showcase {
                display: none !important;
            }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .brand-showcase {
            background: linear-gradient(135deg, #090d16 0%, #064e3b 50%, #1e3a8a 100%);
            padding: 52px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #ffffff;
            position: relative;
            overflow: hidden;
        }

        /* SVG court lines overlay */
        .brand-court-lines {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.12;
            pointer-events: none;
        }

        .brand-logo {
            font-family: 'Outfit', sans-serif;
            font-size: 1.9rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 2;
        }

        .brand-logo i {
            color: #10b981;
            filter: drop-shadow(0 2px 10px rgba(16, 185, 129, 0.6));
        }

        .showcase-content {
            z-index: 2;
            margin-top: 60px;
            margin-bottom: 60px;
        }

        .showcase-content h2 {
            font-size: 2.3rem;
            font-weight: 900;
            line-height: 1.25;
            margin-bottom: 20px;
            letter-spacing: -0.5px;
            background: linear-gradient(to right, #ffffff, #a7f3d0, #bfdbfe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .showcase-content p {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1rem;
            line-height: 1.6;
        }

        .showcase-footer {
            z-index: 2;
        }

        /* Floating animated shuttlecock SVG */
        .shuttlecock-floater {
            position: absolute;
            bottom: 40px;
            right: 40px;
            width: 90px;
            height: 90px;
            color: rgba(16, 185, 129, 0.25);
            pointer-events: none;
            animation: floatShuttlecock 6s ease-in-out infinite alternate;
        }

        @@keyframes floatShuttlecock {
            0% { transform: translateY(0) rotate(-15deg) scale(0.9); }
            100% { transform: translateY(-20px) rotate(15deg) scale(1.1); }
        }

        .register-card {
            padding: 44px 52px;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        @@media (max-width: 575px) {
            .brand-showcase, .register-card {
                padding: 36px 24px;
            }
        }

        .form-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 6px;
            letter-spacing: -0.5px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 16px;
        }

        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 1.1rem;
            z-index: 10;
        }

        .form-control-custom {
            width: 100%;
            padding: 12px 16px 12px 48px;
            border: 1.5px solid #cbd5e1;
            border-radius: 12px;
            background: #f8fafc;
            font-size: 0.92rem;
            font-weight: 500;
            color: #0f172a;
            transition: all 0.25s ease-in-out;
        }

        .form-control-custom:focus {
            border-color: var(--primary-color);
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.18);
            outline: none;
        }

        .btn-register {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            border: none;
            padding: 13px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 1rem;
            width: 100%;
            transition: all 0.25s ease;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
            font-family: 'Outfit', sans-serif;
            letter-spacing: 1px;
        }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
        }

        .auth-link {
            color: #10b981;
            font-weight: 700;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .auth-link:hover {
            color: #059669;
            text-decoration: underline;
        }

        .field-validation-error {
            color: #b91c1c;
            font-size: 0.8rem;
            margin-top: 4px;
            display: block;
        }
    </style>
</head>
<body>

    <!-- Ambient background badminton court -->
    <svg class="ambient-court-bg" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
        <rect x="100" y="50" width="600" height="500" fill="none" stroke="rgba(16, 185, 129, 0.3)" stroke-width="1.5"/>
        <line x1="100" y1="300" x2="700" y2="300" stroke="rgba(16, 185, 129, 0.2)" stroke-width="1.5"/>
        <line x1="400" y1="50" x2="400" y2="550" stroke="rgba(16, 185, 129, 0.2)" stroke-width="1.5"/>
        <line x1="100" y1="90" x2="700" y2="90" stroke="rgba(16, 185, 129, 0.15)" stroke-width="1"/>
        <line x1="100" y1="510" x2="700" y2="510" stroke="rgba(16, 185, 129, 0.15)" stroke-width="1"/>
    </svg>

    <div class="register-wrapper">
        <div class="brand-showcase">
            <!-- Badminton court overlay in banner -->
            <svg class="brand-court-lines" viewBox="0 0 400 600" xmlns="http://www.w3.org/2000/svg">
                <rect x="40" y="40" width="320" height="520" fill="none" stroke="#10b981" stroke-width="2"/>
                <line x1="40" y1="300" x2="360" y2="300" stroke="#10b981" stroke-width="2"/>
                <line x1="200" y1="40" x2="200" y2="560" stroke="#10b981" stroke-width="1"/>
                <line x1="40" y1="80" x2="360" y2="80" stroke="#10b981" stroke-width="1"/>
                <line x1="40" y1="520" x2="360" y2="520" stroke="#10b981" stroke-width="1"/>
            </svg>

            <div class="brand-logo">
                <i class="bi bi-lightning-charge-fill"></i> Aquar SmashCourt
            </div>

            <div class="showcase-content">
                <h2>Bắt đầu hành trình tập luyện chuyên nghiệp</h2>
                <p>Gia nhập câu lạc bộ để nhận đặc quyền đặt sân nhanh, tự động lưu giữ video highlights thi đấu, quản lý giao dịch và được tư vấn trực tiếp bởi trợ lý ảo AI.</p>
            </div>

            <svg class="shuttlecock-floater" viewBox="0 0 100 100">
                <path d="M50 15 C30 40 25 75 25 80 L75 80 C75 75 70 40 50 15 Z" fill="none" stroke="currentColor" stroke-width="2.5"/>
                <line x1="25" y1="80" x2="75" y2="80" stroke="currentColor" stroke-width="4.5"/>
                <path d="M35 80 L35 86 C35 90 65 90 65 86 L65 80" fill="none" stroke="currentColor" stroke-width="2.5"/>
            </svg>

            <div class="showcase-footer">
                <small class="opacity-75">© 2026 Aquar SmashCourt. Premium Web Portal.</small>
            </div>
        </div>

        <div class="register-card position-relative">
            
            <h3 class="form-title">Đăng ký tài khoản</h3>
            <p class="text-secondary small mb-4">Tạo tài khoản khách hàng để sử dụng hệ thống.</p>

            <form asp-action="Register" asp-controller="Account" method="post">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="input-group-custom">
                    <i class="bi bi-person input-icon"></i>
                    <input asp-for="Username" class="form-control-custom" placeholder="Tên đăng nhập" autocomplete="username" />
                    <span asp-validation-for="Username"></span>
                </div>

                <div class="input-group-custom">
                    <i class="bi bi-card-text input-icon"></i>
                    <input asp-for="FullName" class="form-control-custom" placeholder="Họ và tên" autocomplete="name" />
                    <span asp-validation-for="FullName"></span>
                </div>

                <div class="input-group-custom">
                    <i class="bi bi-telephone input-icon"></i>
                    <input asp-for="PhoneNumber" class="form-control-custom" placeholder="Số điện thoại" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber"></span>
                </div>

                <div class="input-group-custom">
                    <i class="bi bi-lock input-icon"></i>
                    <input asp-for="Password" type="password" class="form-control-custom" placeholder="Mật khẩu" autocomplete="new-password" />
                    <span asp-validation-for="Password"></span>
                </div>

                <div class="input-group-custom">
                    <i class="bi bi-shield-check input-icon"></i>
                    <input asp-for="ConfirmPassword" type="password" class="form-control-custom" placeholder="Xác nhận mật khẩu" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>

                <button type="submit" class="btn-register mt-2">
                    <i class="bi bi-person-plus me-1"></i> ĐĂNG KÝ
                </button>
            </form>

            <p class="text-center text-secondary small mt-4 mb-0">
                Đã có tài khoản?
                <a class="auth-link fw-bold" asp-action="Login" asp-route-returnUrl="@returnUrl">Đăng nhập</a>
            </p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        // Simple observer for the login/register animations
        document.addEventListener("DOMContentLoaded", function() {
            setTimeout(() => {
                const el = document.querySelector('.scroll-hidden');
                if(el) el.classList.add('scroll-show');
            }, 300);
        });
    </script>
</body>
</html>

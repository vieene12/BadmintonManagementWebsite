@model RegisterViewModel
@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dang ky - Aquar SmashCourt</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at 0% 0%, rgba(99, 102, 241, 0.14), transparent 45%),
                        radial-gradient(circle at 100% 100%, rgba(16, 185, 129, 0.12), transparent 45%),
                        linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            font-family: Arial, sans-serif;
        }

        .register-card {
            width: 100%;
            max-width: 520px;
            padding: 36px;
            background: rgba(255, 255, 255, 0.82);
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 18px;
            box-shadow: 0 20px 40px -18px rgba(15, 23, 42, 0.24);
        }

        .form-title {
            color: #0f172a;
            font-size: 1.7rem;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 16px;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 14px;
            color: #64748b;
        }

        .form-control-custom {
            width: 100%;
            padding: 12px 14px 12px 42px;
            border: 1.5px solid #cbd5e1;
            border-radius: 10px;
            background: #ffffff;
            color: #0f172a;
        }

        .form-control-custom:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.14);
            outline: none;
        }

        .btn-register {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 10px;
            background: #4f46e5;
            color: #ffffff;
            font-weight: 700;
        }

        .btn-register:hover {
            background: #4338ca;
        }

        .auth-link {
            color: #4f46e5;
            font-weight: 700;
            text-decoration: none;
        }

        .validation-summary-errors,
        .field-validation-error {
            color: #b91c1c;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <main class="register-card">
        <div class="mb-4">
            <div class="text-primary fw-bold mb-2"><i class="bi bi-lightning-charge-fill"></i> Aquar SmashCourt</div>
            <h1 class="form-title">&#272;&#259;ng k&#253; t&#224;i kho&#7843;n</h1>
            <p class="text-secondary small mb-0">T&#7841;o t&#224;i kho&#7843;n kh&#225;ch h&#224;ng &#273;&#7875; s&#7917; d&#7909;ng h&#7879; th&#7889;ng.</p>
        </div>

        <form asp-action="Register" asp-controller="Account" method="post">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

            <div class="input-group-custom">
                <i class="bi bi-person input-icon"></i>
                <input asp-for="Username" class="form-control-custom" placeholder="T&#234;n &#273;&#259;ng nh&#7853;p" autocomplete="username" />
                <span asp-validation-for="Username"></span>
            </div>

            <div class="input-group-custom">
                <i class="bi bi-card-text input-icon"></i>
                <input asp-for="FullName" class="form-control-custom" placeholder="H&#7885; v&#224; t&#234;n" autocomplete="name" />
                <span asp-validation-for="FullName"></span>
            </div>

            <div class="input-group-custom">
                <i class="bi bi-telephone input-icon"></i>
                <input asp-for="PhoneNumber" class="form-control-custom" placeholder="S&#7889; &#273;i&#7879;n tho&#7841;i" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber"></span>
            </div>

            <div class="input-group-custom">
                <i class="bi bi-lock input-icon"></i>
                <input asp-for="Password" class="form-control-custom" placeholder="M&#7853;t kh&#7849;u" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="input-group-custom">
                <i class="bi bi-shield-check input-icon"></i>
                <input asp-for="ConfirmPassword" class="form-control-custom" placeholder="X&#225;c nh&#7853;n m&#7853;t kh&#7849;u" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn-register mt-2">
                <i class="bi bi-person-plus me-1"></i> &#272;&#259;ng K&#253;
            </button>
        </form>

        <p class="text-center text-secondary small mt-4 mb-0">
            &#272;&#227; c&#243; t&#224;i kho&#7843;n?
            <a class="auth-link" asp-action="Login" asp-route-returnUrl="@returnUrl">&#272;&#259;ng nh&#7853;p</a>
        </p>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>

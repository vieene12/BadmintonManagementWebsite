@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập - Aquar SmashCourt</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --primary-color: #10b981;
            --primary-hover: #059669;
            --accent-blue: #3b82f6;
            --bg-gradient: radial-gradient(circle at 10% 20%, rgba(16, 185, 129, 0.18) 0%, transparent 45%), radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.18) 0%, transparent 45%), #f8fafc;
            --glass-bg: rgba(255, 255, 255, 0.85);
            --glass-border: rgba(226, 232, 240, 0.9);
        }

        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient court lines in the body background */
        .ambient-court-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.35;
        }

        .login-wrapper {
            width: 100%;
            max-width: 1000px;
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: 0 25px 60px rgba(15, 23, 42, 0.12);
            overflow: hidden;
            z-index: 1;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @@media (max-width: 991px) {
            .login-wrapper {
                grid-template-columns: 1fr;
                max-width: 500px;
            }

            .brand-showcase {
                display: none !important;
            }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .brand-showcase {
            background: linear-gradient(135deg, #090d16 0%, #064e3b 50%, #1e3a8a 100%);
            padding: 52px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #ffffff;
            position: relative;
            overflow: hidden;
        }

        /* SVG badminton court elements inside the brand side panel */
        .brand-court-lines {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.12;
            pointer-events: none;
        }

        .brand-logo {
            font-family: 'Outfit', sans-serif;
            font-size: 1.9rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 2;
        }

        .brand-logo i {
            color: #10b981;
            filter: drop-shadow(0 2px 10px rgba(16, 185, 129, 0.6));
        }

        .showcase-content {
            z-index: 2;
            margin-top: 60px;
            margin-bottom: 60px;
        }

        .showcase-content h2 {
            font-size: 2.3rem;
            font-weight: 900;
            line-height: 1.25;
            margin-bottom: 20px;
            letter-spacing: -0.5px;
            background: linear-gradient(to right, #ffffff, #a7f3d0, #bfdbfe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .showcase-content p {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1rem;
            line-height: 1.6;
        }

        .showcase-footer {
            z-index: 2;
        }

        /* Floating shuttlecock animation in login */
        .shuttlecock-floater {
            position: absolute;
            bottom: 40px;
            right: 40px;
            width: 90px;
            height: 90px;
            color: rgba(16, 185, 129, 0.25);
            pointer-events: none;
            animation: floatShuttlecock 6s ease-in-out infinite alternate;
        }

        @@keyframes floatShuttlecock {
            0% { transform: translateY(0) rotate(-15deg) scale(0.9); }
            100% { transform: translateY(-20px) rotate(15deg) scale(1.1); }
        }

        .login-card {
            padding: 52px;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        @@media (max-width: 575px) {
            .brand-showcase, .login-card {
                padding: 36px 24px;
            }
        }

        .form-title {
            font-size: 1.9rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 6px;
            letter-spacing: -0.5px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 20px;
        }

        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 1.15rem;
            z-index: 10;
        }

        .form-control-custom {
            width: 100%;
            padding: 14px 16px 14px 48px;
            border: 1.5px solid #cbd5e1;
            border-radius: 12px;
            background: #f8fafc;
            font-size: 0.95rem;
            font-weight: 500;
            color: #0f172a;
            transition: all 0.25s ease-in-out;
        }

        .form-control-custom:focus {
            border-color: var(--primary-color);
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.18);
            outline: none;
        }

        .btn-login {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 1rem;
            width: 100%;
            transition: all 0.25s ease;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
            font-family: 'Outfit', sans-serif;
            letter-spacing: 1px;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
        }

        .text-danger-custom {
            background: rgba(239, 68, 68, 0.08);
            border-left: 4px solid #ef4444;
            color: #b91c1c;
            padding: 14px;
            border-radius: 8px;
            font-size: 0.88rem;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <!-- Ambient background badminton court -->
    <svg class="ambient-court-bg" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
        <!-- Court boundary lines -->
        <rect x="100" y="50" width="600" height="500" fill="none" stroke="rgba(16, 185, 129, 0.3)" stroke-width="1.5"/>
        <!-- Inner lines -->
        <line x1="100" y1="300" x2="700" y2="300" stroke="rgba(16, 185, 129, 0.2)" stroke-width="1.5"/>
        <line x1="400" y1="50" x2="400" y2="550" stroke="rgba(16, 185, 129, 0.2)" stroke-width="1.5"/>
        <line x1="100" y1="90" x2="700" y2="90" stroke="rgba(16, 185, 129, 0.15)" stroke-width="1"/>
        <line x1="100" y1="510" x2="700" y2="510" stroke="rgba(16, 185, 129, 0.15)" stroke-width="1"/>
    </svg>

    <div class="login-wrapper">
        <div class="brand-showcase">
            <!-- Badminton court overlay in banner -->
            <svg class="brand-court-lines" viewBox="0 0 400 600" xmlns="http://www.w3.org/2000/svg">
                <rect x="40" y="40" width="320" height="520" fill="none" stroke="#10b981" stroke-width="2"/>
                <line x1="40" y1="300" x2="360" y2="300" stroke="#10b981" stroke-width="2"/>
                <line x1="200" y1="40" x2="200" y2="560" stroke="#10b981" stroke-width="1"/>
                <line x1="40" y1="80" x2="360" y2="80" stroke="#10b981" stroke-width="1"/>
                <line x1="40" y1="520" x2="360" y2="520" stroke="#10b981" stroke-width="1"/>
            </svg>

            <div class="brand-logo">
                <i class="bi bi-lightning-charge-fill"></i> Aquar SmashCourt
            </div>

            <div class="showcase-content">
                <h2>Trải nghiệm dịch vụ cầu lông thông minh</h2>
                <p>Đặt lịch trực tuyến thời gian thực, quản lý dịch vụ gọi sân hiện đại, camera AI tự động quay video thi đấu và tương tác trực tiếp với trợ lý ảo AI thông minh.</p>
            </div>

            <!-- Floating animated shuttlecock SVG -->
            <svg class="shuttlecock-floater" viewBox="0 0 100 100">
                <path d="M50 15 C30 40 25 75 25 80 L75 80 C75 75 70 40 50 15 Z" fill="none" stroke="currentColor" stroke-width="2.5"/>
                <line x1="25" y1="80" x2="75" y2="80" stroke="currentColor" stroke-width="4.5"/>
                <path d="M35 80 L35 86 C35 90 65 90 65 86 L65 80" fill="none" stroke="currentColor" stroke-width="2.5"/>
            </svg>

            <div class="showcase-footer">
                <small class="opacity-75">© 2026 Aquar SmashCourt. Premium Web Portal.</small>
            </div>
        </div>

        <div class="login-card position-relative">
            
            <h3 class="form-title">Đăng nhập</h3>
            <p class="text-secondary small mb-4">Vui lòng nhập tài khoản hội viên của bạn.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="text-danger-custom">
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="input-group-custom">
                    <i class="bi bi-person input-icon"></i>
                    <input type="text" name="username" class="form-control-custom" placeholder="Tên đăng nhập" required autocomplete="username" />
                </div>

                <div class="input-group-custom">
                    <i class="bi bi-lock input-icon"></i>
                    <input type="password" name="password" class="form-control-custom" placeholder="Mật khẩu" required autocomplete="current-password" />
                </div>

                <button type="submit" class="btn-login mt-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i> ĐĂNG NHẬP
                </button>
            </form>

            <p class="text-center text-secondary small mt-4 mb-0">
                Chưa có tài khoản?
                <a class="fw-bold text-decoration-none" style="color: #10b981;" asp-action="Register" asp-route-returnUrl="@returnUrl">Đăng ký ngay</a>
            </p>
        </div>
    </div>

    <script>
        // Simple observer for the login/register animations
        document.addEventListener("DOMContentLoaded", function() {
            setTimeout(() => {
                const el = document.querySelector('.scroll-hidden');
                if(el) el.classList.add('scroll-show');
            }, 300);
        });
    </script>
</body>
</html>
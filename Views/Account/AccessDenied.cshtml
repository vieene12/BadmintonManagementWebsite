@{
    ViewData["Title"] = "Không Có Quyền Truy Cập";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="glass-card p-5 bg-white border border-danger border-opacity-10 glow-card" style="border-radius: 20px;">
                <div class="mb-4">
                    <div class="bg-danger bg-opacity-10 text-danger p-4 rounded-circle d-inline-block" style="font-size: 3rem; line-height: 1;">
                        <i class="bi bi-shield-slash-fill"></i>
                    </div>
                </div>
                
                <h3 class="fw-bold text-dark mb-2" style="letter-spacing: -0.5px;">Bạn không có quyền truy cập trang này</h3>
                <p class="text-secondary mb-4" style="font-size: 0.95rem;">
                    Tính năng này yêu cầu vai trò cao hơn. Vui lòng liên hệ với quản trị viên hệ thống hoặc thay đổi vai trò để tiếp tục.
                </p>

                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-house-door me-1"></i> Về Trang Chủ
                    </a>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary rounded-pill px-4 py-2 bg-white" style="border: 1px solid #cbd5e1;">
                        <i class="bi bi-person-circle me-1"></i> Đăng Nhập Vai Trò Khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

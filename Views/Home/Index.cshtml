        <!-- Court Selector and Category Filters row -->
        <div class="row g-4 mb-4 align-items-center">
            <div class="col-md-4">
                <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem; letter-spacing: 0.5px;">CHỌN SÂN NHẬN ĐỒ:</label>
                <select class="form-select rounded-3 border-2" id="customer-hub-court-select" style="font-weight: 700; border-color: var(--energy-blue);">
                    @foreach (var court in ViewBag.Courts as List<AquarSmartCourt.Models.Court> ?? new List<AquarSmartCourt.Models.Court>())
                    {
                        <option value="@court.CourtId">@court.CourtName</option>
                    }
                </select>
            </div>
            <div class="col-md-8 text-md-end">
                <div class="d-flex flex-wrap gap-2 justify-content-md-end mt-2 mt-md-0">
                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 filter-hub-btn active" onclick="filterHubCategory('All')">Tất cả</button>
                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 filter-hub-btn" onclick="filterHubCategory('Nước uống')">Nước uống</button>
                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 filter-hub-btn" onclick="filterHubCategory('Thuê vợt')">Thuê vợt</button>
                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 filter-hub-btn" onclick="filterHubCategory('Phụ kiện')">Phụ kiện</button>
                </div>
            </div>
        </div>

        <!-- Services Grid -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4" id="customer-hub-services-grid">
            @foreach (var item in ViewBag.Services as List<AquarSmartCourt.Models.ServiceItem> ?? new List<AquarSmartCourt.Models.ServiceItem>())
            {
                var iconClass = "bi-box-seam";
                var categoryColor = "linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)";
                if (item.Category == "Nước uống") 
                {
                    iconClass = "bi-cup-hot-fill text-danger";
                    categoryColor = "linear-gradient(135deg, #ef4444 0%, #b91c1c 100%)";
                }
                else if (item.Category == "Thuê vợt") 
                {
                    iconClass = "bi-lightning-charge-fill text-warning";
                    categoryColor = "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)";
                }
                else if (item.Category == "Phụ kiện") 
                {
                    iconClass = "bi-gear-wide-connected text-primary";
                    categoryColor = "linear-gradient(135deg, #10b981 0%, #047857 100%)";
                }

                <div class="col hub-service-card-wrapper" data-category="@item.Category">
                    <div class="card h-100 p-3 bg-white d-flex flex-column justify-content-between position-relative" style="border: 1px solid rgba(0,0,0,0.08) !important; border-radius: 16px !important; box-shadow: 0 4px 15px rgba(0,0,0,0.02) !important; transition: all 0.3s ease;">
                        <div>
                            <span class="badge mb-2 text-white px-2 py-1" style="background: @categoryColor; border-radius: 6px !important; font-size: 0.65rem; border: none !important;">@item.Category</span>
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="bg-light p-1 d-flex align-items-center justify-content-center service-image-container" style="width: 60px; height: 60px; border: 1px solid rgba(0,0,0,0.06); border-radius: 12px; overflow: hidden;" data-service-id="@item.ServiceItemId">
                                    <i class="bi @iconClass service-icon" style="font-size: 1.8rem;"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1" style="font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.2px;">@item.ItemName</h6>
                                    <div class="text-primary fw-extrabold" style="font-size: 1.1rem; font-weight: 800;">@(((int)item.UnitPrice).ToString("N0", new System.Globalization.CultureInfo("vi-VN")))đ <span class="text-muted small" style="font-size: 0.75rem;">/ @item.Unit</span></div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="text-secondary small fw-bold" style="font-size: 0.75rem;">SỐ LƯỢNG:</span>
                                <div class="input-group input-group-sm" style="width: 120px;">
                                    <button class="btn btn-outline-secondary btn-sm p-1" style="border-top-left-radius: 8px !important; border-bottom-left-radius: 8px !important;" type="button" onclick="decrementHubQty(@item.ServiceItemId)"><i class="bi bi-dash"></i></button>
                                    <input type="number" class="form-control text-center bg-white p-1" style="border-color: #cbd5e1 !important;" id="hub-qty-@item.ServiceItemId" value="1" min="1" max="10" readonly>
                                    <button class="btn btn-outline-secondary btn-sm p-1" style="border-top-right-radius: 8px !important; border-bottom-right-radius: 8px !important;" type="button" onclick="incrementHubQty(@item.ServiceItemId)"><i class="bi bi-plus"></i></button>
                                </div>
                            </div>
                            <button class="btn btn-success w-100 py-2 fw-bold text-white" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important; border: none !important; border-radius: 10px !important; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.25);" onclick="submitCustomerHubOrder(@item.ServiceItemId, '@item.ItemName')">
                                <i class="bi bi-send-fill me-1"></i> Gọi Phục Vụ
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Booking Online Modal Dialog -->
<div class="modal fade" id="onlineBookingModal" tabindex="-1" aria-labelledby="onlineBookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white py-3 rounded-top-4">
                <h5 class="modal-title fw-bold" id="onlineBookingModalLabel"><i class="bi bi-calendar-check me-2"></i>Đặt Sân Trực Tuyến</h5>

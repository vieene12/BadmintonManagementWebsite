@{
    ViewData["Title"] = "Trang Chủ Khách Hàng";
    ViewData["ActivePage"] = "Customer";
}
<style>
    :root {
        --court-green: #10b981;
        --court-green-dark: #047857;
        --court-green-glow: rgba(16, 185, 129, 0.25);
        --energy-blue: #3b82f6;
        --energy-blue-dark: #1d4ed8;
        --energy-blue-glow: rgba(59, 130, 246, 0.25);
        --vibrant-bg: #f1f5f9;
        --card-radius: 18px;
    }

    .sporty-bg-wrapper {
        position: relative;
        overflow: hidden;
        background-color: var(--vibrant-bg) !important;
        padding: 24px 15px;
        min-height: 100vh;
        z-index: 1;
    }
    
    /* Decorative Badminton Court Watermark in Background */
    .court-bg-watermark {
        position: absolute;
        top: 5%;
        left: 5%;
        width: 90%;
        height: 90%;
        opacity: 0.045;
        pointer-events: none;
        z-index: -2;
    }

    .court-bg-watermark rect, 
    .court-bg-watermark line {
        stroke: var(--court-green);
        stroke-width: 2.5;
        fill: none;
    }

    /* Racket design watermark */
    .racket-bg-watermark {
        position: absolute;
        top: 40%;
        right: 8%;
        width: 320px;
        height: 320px;
        opacity: 0.035;
        pointer-events: none;
        z-index: -2;
        transform: rotate(35deg);
        color: var(--energy-blue);
    }
    
    /* Dynamic background decorative elements */
    .bg-court-line-1 {
        position: absolute;
        top: 8%;
        left: -10%;
        width: 60%;
        height: 4px;
        background: linear-gradient(90deg, rgba(16, 185, 129, 0.25) 0%, rgba(59, 130, 246, 0.15) 50%, transparent 100%);
        transform: rotate(-12deg);
        pointer-events: none;
        z-index: -1;
    }
    .bg-court-line-2 {
        position: absolute;
        bottom: 15%;
        right: -10%;
        width: 50%;
        height: 4px;
        background: linear-gradient(90deg, transparent 0%, rgba(59, 130, 246, 0.15) 50%, rgba(16, 185, 129, 0.25) 100%);
        transform: rotate(12deg);
        pointer-events: none;
        z-index: -1;
    }
    
    .floating-shuttlecock-svg {
        position: absolute;
        width: 140px;
        height: 140px;
        color: rgba(16, 185, 129, 0.07) !important;
        pointer-events: none;
        z-index: -1;
        filter: drop-shadow(0 4px 12px rgba(16, 185, 129, 0.15));
        animation: floatShuttle 7s ease-in-out infinite alternate;
    }
    
    @@keyframes floatShuttle {
        0% { transform: translateY(0) rotate(0deg) scale(0.95); }
        100% { transform: translateY(-30px) rotate(20deg) scale(1.05); }
    }
    
    /* Glow-cards for sports vibe */
    .sporty-bg-wrapper .glass-card, 
    .sporty-bg-wrapper .card {
        background: #ffffff !important;
        border: 1px solid rgba(226, 232, 240, 0.9) !important;
        border-radius: var(--card-radius) !important;
        box-shadow: 0 10px 30px rgba(148, 163, 184, 0.06) !important;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }
    
    .sporty-bg-wrapper .glass-card:hover, 
    .sporty-bg-wrapper .card:hover {
        transform: translateY(-5px) !important;
        box-shadow: 0 18px 40px rgba(59, 130, 246, 0.12) !important;
        border-color: var(--energy-blue) !important;
    }

    .active-session-card {
        background: linear-gradient(135deg, #ffffff 0%, rgba(240, 253, 250, 0.95) 100%) !important;
        border: 1px solid rgba(16, 185, 129, 0.25) !important;
    }

    .active-session-card:hover {
        box-shadow: 0 18px 40px rgba(16, 185, 129, 0.14) !important;
        border-color: var(--court-green) !important;
    }
    
    /* Colorful metric block inside active session */
    .active-session-metric {
        background: #f8fafc;
        padding: 16px;
        border-radius: 12px;
        border-left: 5px solid var(--energy-blue);
        box-shadow: 0 4px 12px rgba(148, 163, 184, 0.04);
        transition: all 0.3s ease;
    }
    .active-session-metric:hover {
        background: #f0fdf4;
        border-left-color: var(--court-green);
        transform: scale(1.02);
    }
    
    /* Timetable enhancements */
    .timetable-table {
        border-collapse: separate !important;
        border-spacing: 0 6px !important;
        width: 100%;
    }
    .timetable-table th {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;
        color: #ffffff !important;
        border: none !important;
        font-family: var(--font-title);
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 15px !important;
        letter-spacing: 0.8px;
    }
    .timetable-table td {
        border: 1px solid rgba(226, 232, 240, 0.9) !important;
        border-radius: 8px;
        padding: 14px !important;
        transition: all 0.25s ease;
        background: #ffffff;
    }
    .timetable-table td.empty {
        background-color: rgba(16, 185, 129, 0.07) !important;
        color: var(--court-green-dark) !important;
        font-weight: 700;
        border: 1.5px dashed rgba(16, 185, 129, 0.35) !important;
        cursor: pointer;
    }
    .timetable-table td.empty:hover {
        background-color: rgba(16, 185, 129, 0.15) !important;
        color: #064e3b !important;
        transform: scale(1.02);
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.2) !important;
        border-style: solid !important;
        border-color: var(--court-green) !important;
    }
    .timetable-table td.booked {
        background-color: #f8fafc !important;
        color: #94a3b8 !important;
        font-size: 0.82rem;
        border: 1px solid #e2e8f0 !important;
    }
    .timetable-table td.maintenance {
        background-color: #fff1f2 !important;
        color: #e11d48 !important;
        font-weight: 600;
        border: 1px solid #fecdd3 !important;
    }
    
    /* Glowing active progress bar */
    .session-progress {
        height: 10px !important;
        background-color: #e2e8f0 !important;
        border-radius: 5px !important;
        overflow: hidden;
    }
    .session-progress-bar {
        background: linear-gradient(90deg, var(--court-green) 0%, var(--energy-blue) 100%) !important;
        box-shadow: 0 0 10px rgba(59, 130, 246, 0.4);
    }
    
    /* Live radar dot */
    .live-radar-dot {
        position: relative;
        display: inline-block;
        width: 10px;
        height: 10px;
        background-color: #ef4444;
        border-radius: 50%;
        margin-right: 6px;
    }
    .live-radar-dot::after {
        content: '';
        position: absolute;
        top: -3px;
        left: -3px;
        width: 16px;
        height: 16px;
        background-color: rgba(239, 68, 68, 0.4);
        border-radius: 50%;
        animation: pulseRadar 1.5s infinite;
    }
    @@keyframes pulseRadar {
        0% { transform: scale(0.6); opacity: 1; }
        100% { transform: scale(2); opacity: 0; }
    }
    
    /* Custom style for highlight carousel cards */
    .highlight-card {
        border-radius: 14px !important;
        border: 1px solid rgba(226, 232, 240, 0.9) !important;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03) !important;
        overflow: hidden;
        background: #ffffff;
        transition: all 0.3s ease;
    }
    .highlight-card:hover {
        transform: translateY(-5px) !important;
        box-shadow: 0 12px 25px rgba(59, 130, 246, 0.12) !important;
        border-color: var(--energy-blue) !important;
    }
    
    /* Affiliate tag styles */
    .aff-badge {
        font-size: 0.65rem;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: 800;
        background: linear-gradient(135deg, #ef4444 0%, #f97316 100%);
        color: white;
    }

    /* Product and matchmaking styling upgrades (Replacing black/white blockiness) */
    .hub-service-card-wrapper .card {
        border-radius: var(--card-radius) !important;
        border: 1px solid rgba(226, 232, 240, 0.9) !important;
        box-shadow: 0 6px 18px rgba(148, 163, 184, 0.05) !important;
        overflow: hidden;
    }
    .hub-service-card-wrapper .card:hover {
        border-color: var(--energy-blue) !important;
        box-shadow: 0 12px 25px rgba(59, 130, 246, 0.12) !important;
    }
    .service-image-container {
        border-radius: 12px !important;
        border: 1px solid rgba(226, 232, 240, 0.9) !important;
    }
</style>

<div class="container-fluid px-0 sporty-bg-wrapper">
    <!-- Badminton Court faint vector watermark -->
    <svg class="court-bg-watermark" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
        <rect x="50" y="50" width="700" height="500"/>
        <line x1="50" y1="300" x2="750" y2="300"/>
        <line x1="400" y1="50" x2="400" y2="550"/>
        <line x1="180" y1="50" x2="180" y2="550"/>
        <line x1="620" y1="50" x2="620" y2="550"/>
        <line x1="50" y1="80" x2="750" y2="80"/>
        <line x1="50" y1="520" x2="750" y2="520"/>
    </svg>

    <!-- Racket watermark graphic -->
    <svg class="racket-bg-watermark" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <circle cx="50" cy="30" r="18" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <line x1="50" y1="48" x2="50" y2="85" stroke="currentColor" stroke-width="2"/>
        <line x1="46" y1="85" x2="54" y2="85" stroke="currentColor" stroke-width="3"/>
        <!-- crossed handle -->
        <circle cx="30" cy="40" r="18" fill="none" stroke="currentColor" stroke-width="1.5" transform="rotate(-30 30 40)"/>
        <line x1="42" y1="52" x2="78" y2="78" stroke="currentColor" stroke-width="2"/>
    </svg>

    <div class="bg-court-line-1"></div>
    <div class="bg-court-line-2"></div>
    <!-- SVG shuttlecock backgrounds -->
    <svg class="floating-shuttlecock-svg" style="top: 12%; left: 3%;" viewBox="0 0 100 100">
        <path d="M50 15 C30 40 25 75 25 80 L75 80 C75 75 70 40 50 15 Z" fill="none" stroke="currentColor" stroke-width="2"/>
        <line x1="25" y1="80" x2="75" y2="80" stroke="currentColor" stroke-width="4"/>
        <path d="M35 80 L35 86 C35 90 65 90 65 86 L65 80" fill="none" stroke="currentColor" stroke-width="2"/>
    </svg>
    <svg class="floating-shuttlecock-svg" style="top: 65%; right: 2%; animation-duration: 12s; animation-delay: -3s;" viewBox="0 0 100 100">
        <path d="M50 15 C30 40 25 75 25 80 L75 80 C75 75 70 40 50 15 Z" fill="none" stroke="currentColor" stroke-width="2"/>
        <line x1="25" y1="80" x2="75" y2="80" stroke="currentColor" stroke-width="4"/>
        <path d="M35 80 L35 86 C35 90 65 90 65 86 L65 80" fill="none" stroke="currentColor" stroke-width="2"/>
    </svg>

    <div id="customer-main-view">
        <!-- Hero Banner Section -->
        <div class="mb-4 p-5 text-center text-md-start text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #064e3b 0%, #0f172a 60%, #1e3a8a 100%); border-radius: 20px; box-shadow: 0 12px 35px rgba(6, 78, 59, 0.15);">
            <!-- Glow effects inside the banner -->
            <div class="position-absolute" style="top: -20%; right: -10%; width: 350px; height: 350px; background: radial-gradient(circle, rgba(16, 185, 129, 0.25) 0%, transparent 75%); pointer-events: none;"></div>
            <div class="position-absolute" style="bottom: -20%; left: -10%; width: 280px; height: 280px; background: radial-gradient(circle, rgba(59, 130, 246, 0.3) 0%, transparent 75%); pointer-events: none;"></div>
            
            <div class="row align-items-center position-relative" style="z-index: 2;">
                <div class="col-lg-9 col-md-8">
                    <span class="badge mb-3 px-3 py-2 text-uppercase fw-bold" style="letter-spacing: 2px; font-size: 0.72rem; background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important; border: none !important; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);"><i class="bi bi-fire me-1"></i> SÂN CHƠI CÔNG NGHỆ 2026</span>
                    <h1 class="display-4 fw-black mb-2 text-white" style="letter-spacing: -1.5px; font-weight: 900; font-family: var(--font-title); text-transform: none;">HỆ THỐNG SÂN CẦU LÔNG <span style="background: linear-gradient(to right, #34d399, #60a5fa); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">AQUAR SMASHCOURT</span></h1>
                    <p class="lead mb-4" style="max-width: 750px; font-size: 1.05rem; line-height: 1.6; color: #cbd5e1;">Quy trình đặt sân trực tuyến tự động, bắt cặp ghép đôi thông minh, camera AI tự động lưu giữ highlights và hỗ trợ vận hành bằng Trợ lý ảo AI.</p>
                    <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-md-start">
                        <a href="#booking-section" class="btn btn-success px-4 py-3 text-white fw-bold d-flex align-items-center gap-2" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important; border: none !important; border-radius: 12px !important; box-shadow: 0 5px 18px rgba(16, 185, 129, 0.4);"><i class="bi bi-calendar-event fs-5"></i>ĐẶT SÂN TRỰC TUYẾN</a>
                        <a href="#customer-matchmaking-view" onclick="showCustomerView('matchmaking')" class="btn btn-outline-light px-4 py-3 fw-bold d-flex align-items-center gap-2" style="border-radius: 12px !important; border: 2px solid #ffffff !important; transition: all 0.25s;"><i class="bi bi-people fs-5"></i>TÌM BẠN GHÉP SÂN</a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 d-none d-md-block text-center">
                    <div class="p-4 rounded-circle d-inline-block" style="background: rgba(255, 255, 255, 0.08); border: 2px dashed rgba(255, 255, 255, 0.2); animation: floatAnim 3s ease-in-out infinite;">
                        <i class="bi bi-lightning-fill text-warning" style="font-size: 5.5rem; filter: drop-shadow(0 4px 15px rgba(245, 158, 11, 0.5));"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Style for float animation in hero -->
        <style>
            @@keyframes floatAnim {
                0% { transform: translateY(0px); }
                50% { transform: translateY(-10px); }
                100% { transform: translateY(0px); }
            }
        </style>

    <!-- Sports Events & Match Highlights (Vibrant Media widgets) -->
    <div class="mb-4 px-3 px-md-0">
        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-camera-reels me-2 text-primary"></i>Sự Kiện & Highlight Trận Đấu Mới Nhất</h5>
        <div class="highlight-carousel-container">
            <!-- Highlight Card 1 -->
            <div class="highlight-card">
                <div class="floating-widget-thumbnail" style="background-image: url('https://images.unsplash.com/photo-1560089000-7433a4ebbd64?auto=format&fit=crop&q=80&w=350'); height: 140px; background-size: cover; background-position: center; position: relative;">
                    <div class="floating-widget-play-btn" onclick="simulateVideoPlay('Chung kết Đơn Nam CLB Aquar 2026')">
                        <i class="bi bi-play-fill"></i>
                    </div>
                    <span class="badge bg-danger position-absolute top-0 start-0 m-2" style="font-size: 0.65rem;">NEW MATCH</span>
                </div>
                <div class="p-3">
                    <h6 class="fw-bold text-dark mb-1 text-truncate">Chung kết Đơn Nam 2026</h6>
                    <p class="text-secondary small mb-0 text-truncate">Kịch tính đến set thứ 3 giữa hai hạt giống...</p>
                </div>
            </div>
            <!-- Highlight Card 2 -->
            <div class="highlight-card">
                <div class="floating-widget-thumbnail" style="background-image: url('https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?auto=format&fit=crop&q=80&w=350'); height: 140px; background-size: cover; background-position: center; position: relative;">
                    <div class="floating-widget-play-btn" onclick="simulateVideoPlay('Highlights Smash Trận 3 Sân Con 2')">
                        <i class="bi bi-play-fill"></i>
                    </div>
                    <span class="badge bg-primary position-absolute top-0 start-0 m-2" style="font-size: 0.65rem;">BEST SMASHES</span>
                </div>
                <div class="p-3">
                    <h6 class="fw-bold text-dark mb-1 text-truncate">Highlights Cú Đập Cầu Khủng</h6>
                    <p class="text-secondary small mb-0 text-truncate">Tuyển tập những pha ghi điểm tốc độ cao...</p>
                </div>
            </div>
            <!-- Highlight Card 3 -->
            <div class="highlight-card">
                <div class="floating-widget-thumbnail" style="background-image: url('https://images.unsplash.com/photo-1521412644187-c49fa049e84d?auto=format&fit=crop&q=80&w=350'); height: 140px; background-size: cover; background-position: center; position: relative;">
                    <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2" style="font-size: 0.65rem;">EVENT</span>
                </div>
                <div class="p-3">
                    <h6 class="fw-bold text-dark mb-1 text-truncate">Giải Giao Hữu Mùa Hè 2026</h6>
                    <p class="text-secondary small mb-0 text-truncate">Đăng ký tham gia ngay trước ngày 25/06...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Grid Content -->
    <div class="row g-4">
        <!-- Left Column: Booking & Camera -->
        <div class="col-xl-8 col-lg-7">
            
            <!-- 0. Active Play Session Card (Customer Self-Service) -->
            @{
                var nowVal = DateTime.Now;
                var myBookingsList = ViewBag.MyBookings as List<AquarSmartCourt.Models.Booking> ?? new List<AquarSmartCourt.Models.Booking>();
                
                // Find the active booking right now (today)
                var activeSession = myBookingsList.FirstOrDefault(b => b.StartTime <= nowVal && nowVal < b.EndTime && b.Status == "Confirmed");
                var showUpcoming = false;
                
                // If no active booking, find the nearest upcoming booking today
                if (activeSession == null)
                {
                    activeSession = myBookingsList.FirstOrDefault(b => b.StartTime > nowVal && b.StartTime.Date == nowVal.Date && b.Status == "Confirmed");
                    if (activeSession != null)
                    {
                        showUpcoming = true;
                    }
                }
            }

            <div class="card border-0 glass-card active-session-card p-4 mb-4 active-session-card-horizontal" id="active-session-section">
                @if (activeSession != null)
                {
                    var courtName = activeSession.Court != null ? activeSession.Court.CourtName : "Sân Con 01";
                    var timeRange = $"{activeSession.StartTime.ToString("HH:mm")} - {activeSession.EndTime.ToString("HH:mm")}";
                    
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <div>
                            <h4 class="mb-1 fw-bold text-dark"><i class="bi bi-activity text-success me-2"></i>Phiên Chơi Của Bạn</h4>
                            <small class="text-muted">Hệ thống ghi nhận phiên hoạt động thời gian thực tại câu lạc bộ</small>
                        </div>
                        @if (showUpcoming)
                        {
                            <span class="status-badge warning bg-warning bg-opacity-10 text-warning border-warning" style="border: 1px solid rgba(255, 193, 7, 0.2); border-radius: 20px; padding: 4px 12px; font-size: 0.8rem; font-weight: 600;">
                                <span class="recording-dot d-inline-block me-1 bg-warning"></span> Sắp diễn ra
                            </span>
                        }
                        else
                        {
                            <span class="status-badge available" style="background: hsla(var(--success-hsl), 0.1); color: var(--accent-success-dark);">
                                <span class="live-radar-dot d-inline-block me-1"></span> Đang hoạt động
                            </span>
                        }
                    </div>
                    <div class="row align-items-center g-4">
                        <div class="col-12">
                            <!-- Show metadata in a clean horizontal dashboard row -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <div class="active-session-metric">
                                        <small class="text-muted d-block mb-1">VỊ TRÍ SÂN</small>
                                        <span class="badge bg-dark text-white rounded-pill px-3 py-1 fw-bold">@courtName</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="active-session-metric">
                                        <small class="text-muted d-block mb-1">THỜI GIAN CA</small>
                                        <span class="text-primary fw-bold" style="font-size: 1.1rem;">@timeRange</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="active-session-metric">
                                        <small class="text-muted d-block mb-1">HỘI VIÊN ĐẶT</small>
                                        <span class="text-dark fw-bold" style="font-size: 1.1rem;">@activeSession.CustomerName</span>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Progress bar calculations -->
                            <div class="mt-3 p-3 border rounded-3 bg-light" id="session-progress-container" data-start="@activeSession.StartTime.ToString("o")" data-end="@activeSession.EndTime.ToString("o")" data-upcoming="@showUpcoming.ToString().ToLower()">
                                @if (showUpcoming)
                                {
                                    var waitMinutes = (int)(activeSession.StartTime - nowVal).TotalMinutes;
                                    var totalPlay = (int)(activeSession.EndTime - activeSession.StartTime).TotalMinutes;
                                    <div class="d-flex justify-content-between small text-muted mb-2" style="font-size: 0.8rem;">
                                        <span id="session-progress-text-left" class="fw-semibold">Bắt đầu sau: @waitMinutes phút</span>
                                        <span id="session-progress-text-right" class="fw-semibold">Thời gian chơi: @totalPlay phút</span>
                                    </div>
                                    <div class="session-progress" style="height: 6px; border-radius: 3px;">
                                        <div class="session-progress-bar bg-warning" id="session-progress-bar-el" style="width: 0%; border-radius: 3px;"></div>
                                    </div>
                                }
                                else
                                {
                                    var totalMin = (activeSession.EndTime - activeSession.StartTime).TotalMinutes;
                                    var elapsedMin = (nowVal - activeSession.StartTime).TotalMinutes;
                                    var remainMin = (activeSession.EndTime - nowVal).TotalMinutes;
                                    var progPercent = Math.Clamp((elapsedMin / totalMin) * 100, 0, 100);
                                    
                                    <div class="d-flex justify-content-between small text-muted mb-2" style="font-size: 0.8rem;">
                                        <span id="session-progress-text-left" class="fw-semibold text-success"><i class="bi bi-clock-history"></i> Đã trôi qua: @((int)elapsedMin) phút (@((int)progPercent)%)</span>
                                        <span id="session-progress-text-right" class="fw-semibold text-danger"><i class="bi bi-hourglass-split"></i> Còn lại: @((int)remainMin) phút</span>
                                    </div>
                                    <div class="session-progress" style="height: 6px; border-radius: 3px;">
                                        <div class="session-progress-bar" id="session-progress-bar-el" style="width: @progPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; border-radius: 3px;"></div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <div>
                            <h4 class="mb-1 fw-bold text-dark"><i class="bi bi-activity text-secondary me-2"></i>Phiên Chơi Hiện Tại</h4>
                            <small class="text-muted">Hệ thống ghi nhận phiên hoạt động thời gian thực tại câu lạc bộ</small>
                        </div>
                        <span class="status-badge text-secondary border-secondary bg-secondary bg-opacity-10" style="border: 1px solid rgba(108, 117, 125, 0.2); border-radius: 20px; padding: 4px 12px; font-size: 0.8rem; font-weight: 600;">
                            <span class="recording-dot d-inline-block me-1 bg-secondary"></span> Không có phiên chơi
                        </span>
                    </div>
                    <div class="text-center py-4 bg-light rounded-4 border">
                        <i class="bi bi-activity text-muted" style="font-size: 2.5rem;"></i>
                        <p class="text-secondary small mt-2 mb-0">Bạn hiện không có ca chơi nào đang diễn ra hoặc sắp bắt đầu hôm nay.</p>
                        <a href="#booking-section" class="btn btn-primary btn-sm rounded-pill px-3 mt-2">Đặt sân chơi ngay</a>
                    </div>
                }
            </div>

            <!-- 0.5. Customer My Bookings Section -->
            <div class="glass-card p-4 mb-4 glow-card" id="my-bookings-section">
                <h4 class="mb-1 fw-bold text-dark"><i class="bi bi-bookmark-star-fill text-warning me-2"></i>Lịch Đặt Sân Của Bạn</h4>
                <p class="text-secondary small mb-3">Danh sách các ca chơi bạn đã đặt hoặc đã tham gia ghép cặp.</p>
                
                @{
                    var myBookings = ViewBag.MyBookings as List<AquarSmartCourt.Models.Booking> ?? new List<AquarSmartCourt.Models.Booking>();
                    var myGroups = ViewBag.MyMatchmakingGroups as List<AquarSmartCourt.Models.MatchmakingGroup> ?? new List<AquarSmartCourt.Models.MatchmakingGroup>();
                    var currentUserIdVal = User.FindFirst("UserId")?.Value;
                    int currentUserId = int.TryParse(currentUserIdVal, out int parsedId) ? parsedId : 0;
                }
                
                @if (myBookings.Count == 0)
                {
                    <div class="text-center py-4 bg-light rounded-4 border">
                        <i class="bi bi-calendar-x text-muted" style="font-size: 2.5rem;"></i>
                        <p class="text-secondary small mt-2 mb-0">Bạn chưa có lịch đặt sân nào hôm nay hoặc sắp tới.</p>
                        <a href="#booking-section" class="btn btn-primary btn-sm rounded-pill px-3 mt-2">Đặt sân ngay</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small" style="border-collapse: separate; border-spacing: 0 8px;">
                            <thead>
                                <tr class="text-secondary border-bottom">
                                    <th>Sân</th>
                                    <th>Thời gian</th>
                                    <th>Trạng thái ghép</th>
                                    <th class="text-end">Vai trò / Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in myBookings)
                                {
                                    var matchingGroup = myGroups.FirstOrDefault(g => g.BookingId == booking.BookingId);
                                    <tr class="bg-white rounded-3 shadow-sm" style="border: 1px solid rgba(0,0,0,0.05);">
                                        <td class="fw-bold text-dark">@booking.Court?.CourtName</td>
                                        <td class="text-primary fw-semibold">
                                            <i class="bi bi-clock me-1"></i> @booking.StartTime.ToString("HH:mm") - @booking.EndTime.ToString("HH:mm") (@booking.StartTime.ToString("dd/MM"))
                                        </td>
                                        <td>
                                            @if (matchingGroup == null)
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2">Chưa ghép cặp</span>
                                            }
                                            else if (matchingGroup.Status == "Open")
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2">
                                                    <i class="bi bi-people-fill me-1"></i> Đang chờ (@matchingGroup.PlayersJoined/@matchingGroup.PlayersNeeded)
                                                </span>
                                            }
                                            else if (matchingGroup.Status == "Matched")
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Đã ghép đủ (@matchingGroup.PlayersJoined/@matchingGroup.PlayersNeeded)
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (booking.UserId == currentUserId)
                                            {
                                                @if (matchingGroup == null)
                                                {
                                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold" onclick="openRegisterMatchmakingModal(@booking.BookingId, '@booking.Court?.CourtName', '@booking.StartTime.ToString("HH:mm") - @booking.EndTime.ToString("HH:mm")')">
                                                        <i class="bi bi-share me-1"></i> Ghép cặp
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-light btn-sm rounded-pill px-3 text-muted" disabled>
                                                        <i class="bi bi-check-lg"></i> Đã gửi yêu cầu
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fw-bold">
                                                    <i class="bi bi-person-check-fill me-1"></i> Thành viên ghép
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- 1. Booking Section -->
            <div class="glass-card p-4 mb-4 glow-card" id="booking-section">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="mb-1 fw-bold"><i class="bi bi-calendar3 me-2 text-primary"></i>Lịch Trình Đặt Sân Hôm Nay</h4>
                        <small class="text-muted">Nhấp vào khung giờ trống màu xanh để chọn sân và yêu cầu nước uống đi kèm</small>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="status-badge available" style="font-size: 0.65rem;"><i class="bi bi-check-circle-fill"></i> Trống</span>
                        <span class="status-badge maintenance" style="background: rgba(148, 163, 184, 0.1); color: #475569; border-color: rgba(148, 163, 184, 0.2); font-size: 0.65rem;"><i class="bi bi-lock-fill"></i> Đã thuê</span>
                    </div>
                </div>

                <div class="timetable-container">
                    <table class="timetable-table">
                        <thead>
                            <tr>
                                <th>Khung Giờ</th>
                                @foreach (var court in ViewBag.Courts as List<AquarSmartCourt.Models.Court> ?? new List<AquarSmartCourt.Models.Court>())
                                {
                                    <th>
                                        @court.CourtName
                                        @if (court.Status == "Maintenance")
                                        {
                                            <br/><small class="text-danger" style="font-size: 0.65rem; text-transform: none;"><i class="bi bi-wrench"></i> Bảo trì</small>
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var slots = new List<(string Start, string End)>
                                {
                                    ("05:00", "06:00"),
                                    ("06:00", "07:00"),
                                    ("07:00", "08:00"),
                                    ("08:00", "09:00"),
                                    ("09:00", "10:00"),
                                    ("10:00", "11:00"),
                                    ("11:00", "12:00"),
                                    ("12:00", "13:00"),
                                    ("13:00", "14:00"),
                                    ("14:00", "15:00"),
                                    ("15:00", "16:00"),
                                    ("16:00", "17:00"),
                                    ("17:00", "18:00"),
                                    ("18:00", "19:00"),
                                    ("19:00", "20:00"),
                                    ("20:00", "21:00"),
                                    ("21:00", "22:00")
                                };
                                var courts = ViewBag.Courts as List<AquarSmartCourt.Models.Court> ?? new List<AquarSmartCourt.Models.Court>();
                                var todayBookings = ViewBag.TodayBookings as List<AquarSmartCourt.Models.Booking> ?? new List<AquarSmartCourt.Models.Booking>();
                            }
                            @foreach (var slot in slots)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@slot.Start - @slot.End</td>
                                    @foreach (var court in courts)
                                    {
                                        var startParts = slot.Start.Split(':');
                                        var endParts = slot.End.Split(':');
                                        var slotStart = DateTime.Today.AddHours(int.Parse(startParts[0])).AddMinutes(int.Parse(startParts[1]));
                                        var slotEnd = DateTime.Today.AddHours(int.Parse(endParts[0])).AddMinutes(int.Parse(endParts[1]));

                                        var booking = todayBookings.FirstOrDefault(b => 
                                            b.CourtId == court.CourtId && 
                                            b.StartTime < slotEnd && 
                                            slotStart < b.EndTime
                                        );

                                        if (court.Status == "Maintenance")
                                        {
                                            <td class="maintenance text-danger text-center bg-danger-subtle fw-semibold" style="cursor: not-allowed;" onclick="alert('Sân này đang trong thời gian bảo trì, vui lòng chọn sân khác!')">
                                                <i class="bi bi-wrench me-1"></i> Bảo trì
                                            </td>
                                        }
                                        else if (booking != null)
                                        {
                                            <td class="booked text-muted" onclick="alert('Khung giờ này đã được đặt trước bởi: @(booking.CustomerName)!')">
                                                <i class="bi bi-lock-fill me-1 text-muted"></i> Đã đặt (@booking.CustomerName)
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="empty text-success" onclick="openBookingModal(@court.CourtId, '@court.CourtName', '@slot.Start', '@slot.End')">
                                                <i class="bi bi-plus-circle-fill me-1"></i> Đặt sân
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. Camera surveillance video section -->
            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                    <div>
                        <h4 class="mb-1 fw-bold"><i class="bi bi-camera-reels me-2 text-danger"></i>Video Thi Đấu Tự Động Trích Xuất</h4>
                        <small class="text-muted">Nhận link tải xuống video trận đấu độ nét cao từ hệ thống Camera AI thông minh</small>
                    </div>
                    <span class="status-badge maintenance" style="background: rgba(244, 63, 94, 0.1); color: var(--accent-danger-dark); border-color: rgba(244, 63, 94, 0.2);">
                        <span class="recording-dot d-inline-block me-1"></span> LIVE CAMERA ACTIVE
                    </span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border rounded-4 p-3 bg-white shadow-sm d-flex flex-column justify-content-between glow-card" style="min-height: 150px;">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2">Sân Con 01</span>
                                    <small class="text-muted"><i class="bi bi-clock me-1"></i>Hôm nay: 17:00 - 19:00</small>
                                </div>
                                <h6 class="fw-bold mb-1 text-dark">Lượt chơi: Nguyễn Văn A & Đồng Đội</h6>
                                <small class="text-secondary" style="font-size: 0.8rem;"><i class="bi bi-info-circle me-1"></i>Trạng thái: Sẵn sàng trích xuất</small>
                            </div>
                            <div class="d-flex gap-2 mt-3">
                                <button class="btn btn-outline-primary btn-sm flex-fill rounded-pill" onclick="simulateVideoPlay('Lượt chơi Sân 1 (17h - 19h)')"><i class="bi bi-play-circle me-1"></i>Xem Thử</button>
                                <button class="btn btn-success btn-sm flex-fill rounded-pill" onclick="alert('Đã gửi video qua Zalo/Email đăng ký của bạn!')"><i class="bi bi-send-fill me-1"></i>Nhận Video</button>
                                <button class="btn btn-light btn-sm text-danger rounded-circle border" onclick="alert('Đã xóa bản ghi video theo yêu cầu!')" title="Yêu cầu xóa bảo mật"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded-4 p-3 bg-white shadow-sm d-flex flex-column justify-content-between glow-card" style="min-height: 150px;">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2">Sân Con 03</span>
                                    <small class="text-muted"><i class="bi bi-clock me-1"></i>Hôm qua: 19:00 - 21:00</small>
                                </div>
                                <h6 class="fw-bold mb-1 text-dark">Lượt chơi: Nguyễn Văn A & CLB Smash</h6>
                                <small class="text-secondary" style="font-size: 0.8rem;"><i class="bi bi-check-circle me-1 text-success"></i>Trạng thái: Đã gửi thành công</small>
                            </div>
                            <div class="d-flex gap-2 mt-3">
                                <button class="btn btn-outline-primary btn-sm flex-fill rounded-pill" onclick="simulateVideoPlay('Lượt chơi Sân 3 (Hôm qua)')"><i class="bi bi-play-circle me-1"></i>Xem Lại</button>
                                <button class="btn btn-outline-secondary btn-sm flex-fill rounded-pill" disabled><i class="bi bi-check2-all me-1"></i>Đã Nhận Link</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Affiliate & Info -->
        <div class="col-xl-4 col-lg-4">
            <div class="glass-card p-4 glow-card">
                <h4 class="mb-1 fw-bold"><i class="bi bi-shop me-2 text-primary"></i>Cửa Hàng Phụ Kiện Liên Kết</h4>
                <p class="text-secondary small mb-4">Trang thiết bị cầu lông chính hãng từ các đối tác phân phối chính thức.</p>

                <div class="vstack gap-3">

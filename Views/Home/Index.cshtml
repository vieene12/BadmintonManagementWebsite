                            <div style="width: 150px;">
                                <select class="form-select form-select-sm" id="bookServiceCategoryFilter" onchange="filterBookingServices()">
                                    <option value="All">Tất cả</option>
                                    <option value="Nước uống">Nước uống</option>
                                    <option value="Thuê vợt">Thuê vợt</option>
                                    <option value="Phụ kiện">Phụ kiện</option>
                                </select>
                            </div>
                        </div>
                        <div class="booking-services-list border rounded-3 p-2 bg-light" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var item in ViewBag.Services as List<AquarSmartCourt.Models.ServiceItem> ?? new List<AquarSmartCourt.Models.ServiceItem>())
                            {
                                <div class="booking-service-item d-flex justify-content-between align-items-center py-2 border-bottom" data-category="@item.Category">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input book-svc-checkbox" type="checkbox" value="@item.ServiceItemId" id="bookSvc-@item.ServiceItemId" onchange="toggleBookSvcQty(@item.ServiceItemId)">
                                        <label class="form-check-label small text-dark fw-medium" for="bookSvc-@item.ServiceItemId">
                                            @item.ItemName <span class="text-muted">(@(((int)item.UnitPrice).ToString("N0", new System.Globalization.CultureInfo("vi-VN")))đ/@item.Unit.ToLower())</span>
                                        </label>
                                    </div>
                                    <div style="width: 75px;">
                                        <input type="number" class="form-control form-control-sm text-center book-svc-qty" id="bookSvcQty-@item.ServiceItemId" min="1" value="1" disabled>

    <!-- Customer Order Hub View -->
    <div id="customer-order-view" style="display: none;" class="p-4">
        <!-- Hub Header -->
        <div class="pb-3 mb-4" style="border-bottom: 2px solid; border-image: linear-gradient(to right, var(--energy-blue), var(--court-green)) 1;">
            <h2 class="fw-black text-dark mb-1"><i class="bi bi-cart-check-fill text-primary me-2"></i>DỊCH VỤ GỌI NƯỚC & THUÊ VỢT</h2>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const CURRENT_USER_NAME = '@Html.Raw(User.Identity?.Name ?? "Khách Hàng")';
        const CURRENT_USER_PHONE = '@Html.Raw(User.FindFirst("PhoneNumber")?.Value ?? "0987654321")';

        let bookingModalObj = null;
        let videoModalObj = null;
        let registerMatchmakingModalObj = null;

        // SignalR Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/courtHub")
            .build();

        connection.on("ReceiveUpdate", function() {
            const openModals = $('.modal.show').length;
            if (openModals === 0) {
                location.reload();
            } else {
                console.log("Dữ liệu sân đã thay đổi. Sẽ cập nhật sau.");
            }
        });

        $(document).ready(function() {
            bookingModalObj = new bootstrap.Modal(document.getElementById('onlineBookingModal'));
            videoModalObj = new bootstrap.Modal(document.getElementById('videoPlayModal'));
            registerMatchmakingModalObj = new bootstrap.Modal(document.getElementById('registerMatchmakingModal'));
            loadMatchmakingGroups();
            updateSessionProgress();

            // Load base64 images from localStorage for services pricing table / cards
            document.querySelectorAll('.service-image-container').forEach(el => {
                const id = el.getAttribute('data-service-id');
                const base64 = localStorage.getItem(`service_img_${id}`);
                if (base64) {
                    el.innerHTML = `<img src="${base64}" style="width: 100%; height: 100%; object-fit: cover;">`;
                }
            });

            // Periodic updates
            setInterval(loadMatchmakingGroups, 30000);
            setInterval(updateSessionProgress, 10000);

            connection.start().then(function() {
                console.log("SignalR connected successfully.");
            }).catch(function(err) {
                console.error("SignalR connection error: " + err.toString());
            });
        });

        function toggleBookSvcQty(id) {
            const checkbox = document.getElementById(`bookSvc-${id}`);
            const qtyInput = document.getElementById(`bookSvcQty-${id}`);
            qtyInput.disabled = !checkbox.checked;
            if (!checkbox.checked) qtyInput.value = 1;
        }

        function openBookingModal(courtId, courtName, start, end) {
            document.getElementById('bookCourtId').value = courtId;
            document.getElementById('bookCourtName').value = courtName;
            document.getElementById('bookStart').value = start;
            document.getElementById('bookEnd').value = end;
            
            // Reset service checklist checkboxes
            document.querySelectorAll('.book-svc-checkbox').forEach(cb => {
                cb.checked = false;
                toggleBookSvcQty(cb.value);
            });
            
            bookingModalObj.show();
        }

        function processOnlineBooking(e) {
            e.preventDefault();
            const courtId = parseInt(document.getElementById('bookCourtId').value);
            const court = document.getElementById('bookCourtName').value;
            const start = document.getElementById('bookStart').value;
            const end = document.getElementById('bookEnd').value;
            const cust = document.getElementById('bookCustName').value;
            const phone = document.getElementById('bookCustPhone').value;

            // Gather service items
            const services = [];
            const checkboxes = document.querySelectorAll('.book-svc-checkbox');
            checkboxes.forEach(cb => {
                if (cb.checked) {
                    const id = parseInt(cb.value);
                    const qty = parseInt(document.getElementById(`bookSvcQty-${id}`).value);
                    services.push({ serviceItemId: id, quantity: qty });
                }
            });

            $.ajax({
                url: '/api/CourtApi/book',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    courtId: courtId,
                    customerName: cust,
                    customerPhone: phone,
                    startTime: start,
                    endTime: end,
                    services: services
                }),
                success: function() {
                    alert(`Đặt sân trực tuyến thành công!\nSân: ${court}\nKhung giờ: ${start} - ${end}\nKhách hàng: ${cust}\nHệ thống tự động đồng bộ và lưu thông tin dịch vụ.`);
                    bookingModalObj.hide();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi đặt sân: ' + xhr.responseText);
                }
            });
        }

        function submitActivePlayOrder(e, courtId) {
            e.preventDefault();
            const itemId = parseInt(document.getElementById('activePlayServiceSelect').value);
            const qty = parseInt(document.getElementById('activePlayServiceQty').value);
            const itemName = document.getElementById('activePlayServiceSelect').options[document.getElementById('activePlayServiceSelect').selectedIndex].text;

            const finalCourtId = courtId || 1;

            $.ajax({
                url: '/api/CourtApi/order',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    courtId: finalCourtId,
                    serviceItemId: itemId,
                    quantity: qty
                }),
                success: function() {
                    alert(`Gửi yêu cầu phục vụ thành công!\nĐã đặt: ${itemName}\nSố lượng: ${qty}\nNhân viên lễ tân sẽ chuyển nước/vợt đến sân ngay cho bạn!`);
                    document.getElementById('activePlayServiceQty').value = 1;
                },
                error: function(xhr) {
                    alert('Lỗi order dịch vụ: ' + xhr.responseText);
                }
            });
        }

        function getAvatarColor(name) {
            const hash = [...name].reduce((acc, char) => acc + char.charCodeAt(0), 0);
            const colors = [
                { bg: '#e0e7ff', text: '#4338ca' }, // Indigo
                { bg: '#d1fae5', text: '#065f46' }, // Green
                { bg: '#fee2e2', text: '#991b1b' }, // Red
                { bg: '#fef3c7', text: '#92400e' }, // Amber
                { bg: '#e0f2fe', text: '#075985' }, // Sky
                { bg: '#f3e8ff', text: '#6b21a8' }, // Purple
                { bg: '#fce7f3', text: '#9d174d' }  // Pink
            ];
            return colors[hash % colors.length];
        }

        function updateSessionProgress() {
            const container = document.getElementById('session-progress-container');
            if (!container) return;

            const startStr = container.getAttribute('data-start');
            const endStr = container.getAttribute('data-end');
            const isUpcoming = container.getAttribute('data-upcoming') === 'true';

            if (!startStr || !endStr) return;

            const start = new Date(startStr);
            const end = new Date(endStr);
            const now = new Date();

            const leftTextEl = document.getElementById('session-progress-text-left');
            const rightTextEl = document.getElementById('session-progress-text-right');
            const barEl = document.getElementById('session-progress-bar-el');

            if (isUpcoming) {
                const waitMs = start - now;
                if (waitMs <= 0) {
                    location.reload();
                    return;
                }
                const waitMinutes = Math.ceil(waitMs / 60000);
                const totalPlay = Math.round((end - start) / 60000);
                if (leftTextEl) leftTextEl.innerText = `Bắt đầu sau: ${waitMinutes} phút`;
                if (rightTextEl) rightTextEl.innerText = `Thời gian chơi: ${totalPlay} phút`;
                if (barEl) barEl.style.width = '0%';
            } else {
                const totalMs = end - start;
                const elapsedMs = now - start;
                const remainMs = end - now;

                if (remainMs <= 0) {
                    location.reload();
                    return;
                }

                const totalMin = Math.round(totalMs / 60000);
                const elapsedMin = Math.floor(elapsedMs / 60000);
                const remainMin = Math.ceil(remainMs / 60000);
                const progPercent = Math.max(0, Math.min(100, (elapsedMs / totalMs) * 100));

                if (leftTextEl) leftTextEl.innerText = `Thời gian trôi qua: ${elapsedMin} phút (${Math.round(progPercent)}%)`;
                if (rightTextEl) rightTextEl.innerText = `Còn lại: ${remainMin} phút`;
                if (barEl) barEl.style.width = `${progPercent.toFixed(1)}%`;
            }
        }

        function loadMatchmakingGroups() {
            $.ajax({
                url: '/api/MatchmakingApi/groups',
                type: 'GET',
                success: function(groups) {
                    const listContainer = document.getElementById('matchmakingGroupsList');
                    if (!listContainer) return;
                    listContainer.innerHTML = '';

                    if (groups.length === 0) {
                        listContainer.innerHTML = `
                            <div class="text-center py-4 text-secondary">
                                <i class="bi bi-info-circle me-1"></i> Hiện chưa có nhóm nào chờ ghép.
                            </div>
                        `;
                        return;
                    }

                    groups.forEach(g => {
                        const needed = g.playersNeeded - g.playersJoined;
                        const badgeLabel = g.skillLevel === 'Beginner' ? 'Nhập Môn' : 
                                           g.skillLevel === 'Advanced' ? 'Nâng Cao' : 
                                           'Trung Bình';

                        let avatarsHtml = '';
                        if (g.participants && g.participants.length > 0) {
                            g.participants.forEach(pName => {
                                const initials = pName.trim().split(" ").pop()[0] || pName[0] || "?";
                                const colors = getAvatarColor(pName);
                                avatarsHtml += `<div class="avatar-img" style="background-color: ${colors.bg}; color: ${colors.text};" title="${pName}">${initials}</div>`;
                            });
                        } else {
                            const initials = g.creatorName.trim().split(" ").pop()[0] || g.creatorName[0] || "?";
                            const colors = getAvatarColor(g.creatorName);
                            avatarsHtml += `<div class="avatar-img" style="background-color: ${colors.bg}; color: ${colors.text};" title="${g.creatorName}">${initials}</div>`;
                        }

                        const alreadyJoined = g.participants && g.participants.includes(CURRENT_USER_NAME);
                        const buttonHtml = alreadyJoined 
                            ? `<button class="btn btn-secondary btn-sm w-100 rounded-pill py-2 fw-bold" disabled>Bạn Đã Tham Gia</button>`
                            : `<button class="btn btn-outline-primary btn-sm w-100 rounded-pill py-2 fw-bold" onclick="joinMatchmakingGroup(${g.matchmakingGroupId}, '${g.creatorName}', '${g.startTime}', '${g.endTime}')">Tham Gia Ngay</button>`;

                        const cardHtml = `
                            <div class="border rounded-4 p-3 bg-white shadow-sm glow-card">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="status-badge px-2 py-1 border rounded fw-semibold text-success bg-success bg-opacity-10 border-success" style="font-size: 0.65rem;">${badgeLabel}</span>
                                    <span class="small text-danger fw-bold"><i class="bi bi-person-fill-exclamation me-1"></i>Cần thêm ${needed}</span>
                                </div>
                                <div class="fw-bold text-dark small mb-2"><i class="bi bi-clock me-1 text-primary"></i>${g.startTime} - ${g.endTime} | ${g.courtName}</div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="small text-muted" style="font-size: 0.8rem;">Thành viên hiện tại:</span>
                                    <div class="avatar-group">
                                        ${avatarsHtml}
                                    </div>
                                </div>
                                <div class="text-secondary small mb-3" style="font-size: 0.78rem;">
                                    <i class="bi bi-person me-1 text-muted"></i>Người tạo: <strong>${g.creatorName}</strong>
                                </div>
                                ${buttonHtml}
                            </div>
                        `;
                        listContainer.innerHTML += cardHtml;
                    });
                },
                error: function(xhr) {
                    console.error('Lỗi tải danh sách ghép sân:', xhr.responseText);
                    const listContainer = document.getElementById('matchmakingGroupsList');
                    if (listContainer) {
                        listContainer.innerHTML = `
                            <div class="text-center py-4 text-danger">
                                <i class="bi bi-exclamation-triangle me-1"></i> Không thể tải danh sách nhóm ghép.
                            </div>
                        `;
                    }
                }
            });
        }

        function joinMatchmakingGroup(groupId, creatorName, start, end) {
            let confirmModalEl = document.getElementById('customConfirmModal');
            if (!confirmModalEl) {
                confirmModalEl = document.createElement('div');
                confirmModalEl.id = 'customConfirmModal';
                confirmModalEl.className = 'modal fade';
                confirmModalEl.setAttribute('tabindex', '-1');
                confirmModalEl.setAttribute('aria-hidden', 'true');
                confirmModalEl.style.zIndex = '10000';
                confirmModalEl.innerHTML = `
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: var(--bg-card, #ffffff); color: var(--text-color, #1e293b);">
                            <div class="modal-header border-0 pb-0" style="padding: 1.5rem 1.5rem 0.5rem 1.5rem;">
                                <h5 class="modal-title fw-bold d-flex align-items-center">
                                    <i class="bi bi-question-circle-fill text-warning me-2 fs-4"></i> Xác nhận tham gia
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body py-3 px-4" style="font-size: 1rem; line-height: 1.6;">
                                <!-- Message -->
                            </div>
                            <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                                <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold btn-confirm-action">Xác nhận</button>
                            </div>
                        </div>
                    </div>
                `;
                document.body.appendChild(confirmModalEl);
            }

            confirmModalEl.querySelector('.modal-body').innerHTML = `Bạn có chắc chắn muốn tham gia nhóm ghép của <strong>${creatorName}</strong> trong khung giờ <strong>${start} - ${end}</strong> không?`;
            
            const confirmBtn = confirmModalEl.querySelector('.btn-confirm-action');
            const bsConfirmModal = new bootstrap.Modal(confirmModalEl);
            
            const newConfirmBtn = confirmBtn.cloneNode(true);
            confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);

            newConfirmBtn.addEventListener('click', function() {
                bsConfirmModal.hide();
                
                $.ajax({
                    url: `/api/MatchmakingApi/join/${groupId}`,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        fullName: CURRENT_USER_NAME,
                        phoneNumber: CURRENT_USER_PHONE
                    }),
                    success: function(res) {
                        alert(res.message || 'Tham gia nhóm ghép thành công!');
                        loadMatchmakingGroups();
                        if (res.status === 'Matched') {
                            setTimeout(() => {
                                location.reload();
                            }, 2000);
                        }
                    },
                    error: function(xhr) {
                        alert('Lỗi tham gia nhóm: ' + xhr.responseText);
                    }
                });
            });

            bsConfirmModal.show();
        }

        function openRegisterMatchmakingModal(bookingId, courtName, timeRange) {
            document.getElementById('matchBookingId').value = bookingId;
            document.getElementById('matchCourtName').textContent = courtName;
            document.getElementById('matchTimeRange').textContent = timeRange;
            registerMatchmakingModalObj.show();
        }

        function submitRegisterMatchmaking(e) {
            e.preventDefault();
            const bookingId = parseInt(document.getElementById('matchBookingId').value);
            const level = document.getElementById('matchSkill').value;
            const neededVal = parseInt(document.getElementById('matchNeeded').value);
            const totalPlayersNeeded = 1 + neededVal;
            const creatorName = document.getElementById('matchCreatorName').value;
            const creatorPhone = document.getElementById('matchCreatorPhone').value;

            $.ajax({
                url: '/api/MatchmakingApi/request',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    bookingId: bookingId,
                    skillLevel: level,
                    playersNeeded: totalPlayersNeeded,
                    creatorName: creatorName,
                    creatorPhone: creatorPhone
                }),
                success: function(res) {
                    alert('Đăng ký ghép đôi thành công!\nYêu cầu của bạn đã được đưa lên danh sách ghép sân.');
                    registerMatchmakingModalObj.hide();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi tạo nhóm ghép: ' + xhr.responseText);
                }
            });
        }

        function filterActivePlayServices() {
            const selectedCategory = document.getElementById('activePlayCategorySelect').value;
            const serviceSelect = document.getElementById('activePlayServiceSelect');
            const options = serviceSelect.querySelectorAll('option');

            let firstVisibleIndex = -1;
            options.forEach((opt, idx) => {
                const cat = opt.getAttribute('data-category');
                if (selectedCategory === "All" || cat === selectedCategory) {
                    opt.style.display = '';
                    if (firstVisibleIndex === -1) {
                        firstVisibleIndex = idx;
                    }
                } else {
                    opt.style.display = 'none';
                }
            });

            if (firstVisibleIndex !== -1) {
                serviceSelect.selectedIndex = firstVisibleIndex;
            } else {
                serviceSelect.selectedIndex = -1;
            }
        }

        function filterBookingServices() {
            const filterVal = document.getElementById('bookServiceCategoryFilter').value;
            const items = document.querySelectorAll('.booking-service-item');
            items.forEach(item => {
                const cat = item.getAttribute('data-category');
                if (filterVal === "All" || cat === filterVal) {
                    item.style.setProperty('display', 'flex', 'important');
                } else {
                    item.style.setProperty('display', 'none', 'important');
                }
            });
        }

        function simulateVideoPlay(title) {
            document.getElementById('simVideoTitle').innerText = `Xem Lại: ${title}`;
            const timeCode = new Date().toLocaleTimeString();
            document.getElementById('simTimeCode').innerText = `TIMESTAMP: ${timeCode} | CAM_ID_01`;
            videoModalObj.show();
        }

        function decrementHubQty(id) {
            const input = document.getElementById(`hub-qty-${id}`);
            if (input && parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
            }
        }

        function incrementHubQty(id) {
            const input = document.getElementById(`hub-qty-${id}`);
            if (input && parseInt(input.value) < 10) {
                input.value = parseInt(input.value) + 1;
            }
        }

        function filterHubCategory(category) {
            const btns = document.querySelectorAll('.filter-hub-btn');
            btns.forEach(btn => btn.classList.remove('active'));
            
            if (window.event && window.event.target) {
                window.event.target.classList.add('active');
            }

            const cards = document.querySelectorAll('.hub-service-card-wrapper');
            cards.forEach(card => {
                const cat = card.getAttribute('data-category');
                if (category === 'All' || cat === category) {
                    card.style.setProperty('display', 'block', 'important');
                } else {
                    card.style.setProperty('display', 'none', 'important');
                }
            });
        }

        function submitCustomerHubOrder(itemId, itemName) {
            const courtId = parseInt(document.getElementById('customer-hub-court-select').value);
            const qty = parseInt(document.getElementById(`hub-qty-${itemId}`).value);

            $.ajax({
                url: '/api/CourtApi/order',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    courtId: courtId,
                    serviceItemId: itemId,
                    quantity: qty
                }),
                success: function() {
                    alert(`Gửi yêu cầu phục vụ thành công!\nĐã đặt: ${itemName}\nSố lượng: ${qty}\nNhân viên sẽ chuyển sản phẩm đến sân của bạn ngay!`);
                    document.getElementById(`hub-qty-${itemId}`).value = 1;
                },
                error: function(xhr) {
                    alert('Lỗi order dịch vụ: ' + xhr.responseText);
                }
            });
        }
    </script>
}

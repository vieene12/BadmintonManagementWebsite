        <div class="alert alert-success rounded-4 border-0 p-4 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background: linear-gradient(135deg, rgba(240, 253, 250, 0.9) 0%, rgba(204, 251, 241, 0.9) 100%); border-left: 5px solid var(--court-green) !important;">

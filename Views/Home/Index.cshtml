                    <div class="mb-2">
                        <label class="form-label fw-semibold text-dark small mb-1">Ghi chú thêm</label>
                        <textarea class="form-control rounded-3" id="bookNotes" rows="2" placeholder="Yêu cầu dịch vụ đặc biệt..."></textarea>

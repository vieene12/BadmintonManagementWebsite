                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-primary fw-extrabold" style="font-weight: 800;">2.150.000đ</span>
                                    <a href="https://shopvnb.com/" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3 py-1" style="font-size: 0.78rem;"><i class="bi bi-box-arrow-up-right me-1"></i>Mua Ngay</a>

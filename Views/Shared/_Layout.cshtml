@using System.Security.Claims
@{
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value;
    var userName = User.Identity?.Name ?? "Khách";
    var userPosition = User.FindFirst("Position")?.Value ?? "Thành viên";
    var staffCode = User.FindFirst("StaffCode")?.Value;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aquar SmashCourt</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AquarSmartCourt.styles.css" asp-append-version="true" />
    <script>
            // Init theme immediately to prevent flashing
            (function() {
                var currentTheme = localStorage.getItem('theme') || 'light';
                if (currentTheme === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            })();

            // Expose server auth state to frontend scripts
            window.authConfig = {
                isAuthenticated: @(User.Identity?.IsAuthenticated.ToString().ToLower() ?? "false"),
                role: '@userRole',
                username: '@Html.Raw(userName)',
                position: '@Html.Raw(userPosition)',
                staffCode: '@staffCode'
            };

            // Immediate Client-side Protected Routes (Route Guards)
            (function() {
                var currentUrl = window.location.pathname.toLowerCase();
                var role = window.authConfig.role || localStorage.getItem('role') || '';
                var token = localStorage.getItem('token') || (window.authConfig.isAuthenticated ? 'server_token' : '');

                if (currentUrl.indexOf('/manager') !== -1) {
                    if (!token || role !== '3') {
                        window.location.href = '/Account/AccessDenied';
                    }
                } else if (currentUrl.indexOf('/receptionist') !== -1) {
                    if (!token || (role !== '2' && role !== '3')) {
                        window.location.href = '/Account/AccessDenied';
                    }
                }
            })();
    </script>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    
@if (userRole == "2" || userRole == "3")
{
    <!-- Admin & Staff Dashboard with Left Sidebar -->
    <div class="admin-layout">
        <!-- Sidebar Navigation Drawer -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar-header">
                <span class="admin-sidebar-logo">
                    <i class="bi bi-lightning-charge-fill"></i> AQUAR COURT
                </span>
            </div>
            
            <ul class="admin-sidebar-menu">
                @if (userRole == "3")
                {
                    <li class="admin-sidebar-item">
                        <a href="#" class="admin-sidebar-link active" data-tab="tab-overview">
                            <i class="bi bi-speedometer2"></i> Tổng quan
                        </a>
                    </li>
                    <li class="admin-sidebar-item">
                        <a href="#" class="admin-sidebar-link" data-tab="tab-courts">
                            <i class="bi bi-grid-3x3-gap"></i> Quản lý sân
                        </a>
                    </li>
                    <li class="admin-sidebar-item">
                        <a href="#" class="admin-sidebar-link" data-tab="tab-services">
                            <i class="bi bi-tags"></i> Dịch vụ
                        </a>
                    </li>
                    <li class="admin-sidebar-item">
                        <a href="#" class="admin-sidebar-link" data-tab="tab-staff">
                            <i class="bi bi-shield-lock"></i> Nhân sự
                        </a>
                    </li>
                    <li class="admin-sidebar-item">
                        <a href="#" class="admin-sidebar-link" data-tab="tab-camera">
                            <i class="bi bi-camera-video"></i> Camera giám sát
                        </a>
                    </li>
                }
                else if (userRole == "2")
                {
                    <li class="admin-sidebar-item">
                        <a href="#" class="admin-sidebar-link active" data-tab="tab-courts">
                            <i class="bi bi-grid-3x3-gap"></i> Trạng thái sân
                        </a>
                    </li>
                    <li class="admin-sidebar-item">
                        <a href="#" class="admin-sidebar-link" data-tab="tab-schedule">
                            <i class="bi bi-calendar-range"></i> Sơ đồ lịch đặt
                        </a>
                    </li>
                    <li class="admin-sidebar-item">
                        <a href="#" class="admin-sidebar-link" data-tab="tab-customers">
                            <i class="bi bi-search"></i> Tra cứu khách
                        </a>
                    </li>
                    <li class="admin-sidebar-item">
                        <a href="#" class="admin-sidebar-link" data-tab="tab-shift">
                            <i class="bi bi-wallet2"></i> Kiểm kê ca
                        </a>
                    </li>
                    <li class="admin-sidebar-item">
                        <a href="#" class="admin-sidebar-link" data-tab="tab-services">
                            <i class="bi bi-tags"></i> Bảng giá dịch vụ
                        </a>
                    </li>
                }
            </ul>
            
            <div class="admin-sidebar-footer">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-circle fs-5"></i>
                    <div style="line-height: 1.2;">
                        <small class="text-muted d-block" style="font-size: 10px;">@userPosition</small>
                        <span class="fw-bold" style="font-size: 12px; color: #fff;">@userName</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Overlay for Mobile Sidebar trượt -->
        <div class="admin-sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <!-- Main Workspace -->
        <div class="admin-main">
            <header class="admin-header">
                <div class="admin-header-left">
                    <button class="sidebar-toggle-btn d-lg-none" onclick="toggleSidebar()">
                        <i class="bi bi-list"></i>
                    </button>
                    <h5 class="admin-header-title">@ViewData["Title"]</h5>
                </div>
                <div class="admin-header-right">
                    <a class="btn btn-outline-danger btn-sm px-3" href="@Url.Action("Logout", "Account")">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </a>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <!-- Customer / Guest Layout with Top Header Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light navbar-custom py-2 header-customer-sporty">
            <div class="container-fluid px-4">
                <a class="navbar-brand navbar-brand-custom" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-lightning-charge-fill"></i> Aquar SmashCourt
                </a>
                
                <div class="d-flex align-items-center gap-2 ms-auto d-lg-none">
                    @if (userRole == "1")
                    {
                        <button class="btn btn-outline-success btn-sm" id="btn-toggle-matching-mobile" onclick="toggleCustomerMatchmakingView()">
                            <i class="bi bi-people-fill me-1"></i> Ghép sân
                        </button>
                        <button class="btn btn-cta-header btn-sm" id="btn-toggle-order-mobile" onclick="toggleCustomerOrderView()">
                            <i class="bi bi-cart-fill me-1"></i> Gọi nước
                        </button>
                    }
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
                
                <div class="collapse navbar-collapse" id="navbarColor01">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        @if (userRole == "1")
                        {
                            <li class="nav-item">
                                <a class="nav-link py-2 px-3 fw-semibold active" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-people-fill me-1"></i> Khách Hàng
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3 position-relative">
                        <!-- Chibi Greeting Sticker for Guest/Customer -->
                        <div class="sticker-floating-corner sticker-wave d-none d-md-block" style="top: 25px; right: 120px; width: 65px;">
                            <img src="~/images/stickers/chibi-wave.png" alt="hello sticker" style="width: 100%;" onerror="this.style.display='none'" />
                        </div>

                        @if (userRole == "1")
                        {
                            <button class="btn btn-outline-success btn-sm d-none d-lg-inline-block px-3" id="btn-toggle-matching-desktop" onclick="toggleCustomerMatchmakingView()">
                                <i class="bi bi-people-fill me-2"></i> Bắt cặp ghép sân
                            </button>
                            <button class="btn btn-cta-header btn-sm d-none d-lg-inline-block px-3" id="btn-toggle-order-desktop" onclick="toggleCustomerOrderView()">
                                <i class="bi bi-cart-fill me-2"></i> Gọi nước & thuê vợt
                            </button>
                        }

                        <div class="text-end d-none d-sm-block">
                            <small class="text-muted d-block" style="font-size: 0.75rem;">
                                @userPosition @(string.IsNullOrEmpty(staffCode) ? "" : $"({staffCode})")
                            </small>
                            <span class="fw-semibold text-dark">@userName</span>
                        </div>
                        <a class="btn btn-outline-danger btn-sm px-3 fw-bold" href="@Url.Action("Logout", "Account")">
                            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper" style="flex: 1;">
        <div class="container-fluid px-4 py-2">
            <div class="content-area">
                @RenderBody()
            </div>
        </div>
    </div>

    <footer class="mt-5 border-top bg-white py-4">
        <div class="container-fluid px-4">
            <div class="row g-4 justify-content-between align-items-center">
                <div class="col-md-4 text-center text-md-start">
                    <a class="navbar-brand-custom text-decoration-none mb-2 d-inline-flex" href="/">
                        <i class="bi bi-lightning-charge-fill"></i> Aquar SmashCourt
                    </a>
                    <p class="text-secondary small mb-0">Nền tảng quản lý sân cầu lông thông minh cao cấp với công nghệ AI và Automation.</p>
                </div>
                <div class="col-md-4 text-center">
                    <div class="d-flex justify-content-center gap-3">
                        <a href="#" class="text-secondary text-decoration-none custom-hover"><i class="bi bi-facebook fs-5"></i></a>
                        <a href="#" class="text-secondary text-decoration-none custom-hover"><i class="bi bi-indigo fs-5"></i></a>
                        <a href="#" class="text-secondary text-decoration-none custom-hover"><i class="bi bi-youtube fs-5"></i></a>
                        <a href="#" class="text-secondary text-decoration-none custom-hover"><i class="bi bi-tiktok fs-5"></i></a>
                    </div>
                </div>
                <div class="col-md-4 text-center text-md-end text-secondary small">
                    <div class="mb-1"><i class="bi bi-envelope me-1"></i> support@aquarsmash.com</div>
                    <div><i class="bi bi-telephone me-1"></i> Hotline: 1900 8888</div>
                    <div class="mt-2 text-muted" style="font-size: 0.75rem;">&copy; 2026 Aquar Smart Court System. All rights reserved.</div>
                </div>
            </div>
        </div>
    </footer>
}

    <!-- Chatbot AI Widget -->
    <button class="chatbot-toggler" type="button" onclick="toggleChatbot()">
        <i class="bi bi-chat-dots-fill fs-4" style="pointer-events: none;"></i>
    </button>

    <div class="chatbot-window" id="chatbot-window">
        <div class="chat-header">
            <div class="d-flex align-items-center gap-2">
                <div class="position-relative">
                    <i class="bi bi-robot fs-4 text-white"></i>
                    <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle" style="width: 8px; height: 8px;"></span>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Trợ Lý Aquar AI</h6>
                    <small class="opacity-75" id="chatbot-context" style="font-size: 0.72rem;">Phân hệ: Khách hàng</small>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white btn-sm" onclick="toggleChatbot()"></button>
        </div>
        <div class="chat-messages" id="chat-messages">
            <div class="chat-message bot">
                Xin chào! Tôi là trợ lý ảo Aquar SmashCourt. Tôi có thể giúp bạn kiểm tra lịch sân trống, tư vấn phụ kiện thể thao phù hợp, gợi ý nhóm ghép sân.
            </div>
        </div>
        <div class="chat-chips-container" id="chat-chips-container">
        </div>
        <div class="chat-input-area">
            <input type="text" class="chat-input" id="chat-input" placeholder="Nhập câu hỏi của bạn..." onkeypress="handleChatKeyPress(event)">
            <button class="chat-send-btn" type="button" onclick="sendChatMessage()">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function clickChatChip(query) {
            const inputField = document.getElementById('chat-input');
            if(inputField) {
                inputField.value = query;
                sendChatMessage();
            }
        }

        function switchRole(role, name) {
            const userTag = document.getElementById('current-user-tag');
            const chatbotContext = document.getElementById('chatbot-context');
            const chipsContainer = document.getElementById('chat-chips-container');
            const chatMessages = document.getElementById('chat-messages');

            if (userTag && name) userTag.innerText = name;
            if (chatbotContext) {
                if (role === 'Manager') {
                    chatbotContext.innerText = 'Phân hệ: Quản trị (Admin)';
                } else if (role === 'Receptionist') {
                    chatbotContext.innerText = 'Phân hệ: Lễ tân (Receptionist)';
                } else {
                    chatbotContext.innerText = 'Phân hệ: Khách hàng';
                }
            }

            if (chipsContainer) {
                if (role === 'Manager') {
                    chipsContainer.innerHTML = `
                        <span class="chat-chip" onclick="clickChatChip('Báo cáo doanh thu')"><i class="bi bi-cash-coin me-1 text-danger"></i>Xem doanh thu</span>
                        <span class="chat-chip" onclick="clickChatChip('Công suất sử dụng sân')"><i class="bi bi-percent me-1 text-primary"></i>Công suất sân</span>
                        <span class="chat-chip" onclick="clickChatChip('Nhân viên ca trực')"><i class="bi bi-people me-1 text-success"></i>Ca trực lễ tân</span>
                    `;
                } else if (role === 'Receptionist') {
                    chipsContainer.innerHTML = `
                        <span class="chat-chip" onclick="clickChatChip('Danh sách đặt sân hôm nay')"><i class="bi bi-calendar-check me-1 text-primary"></i>Lịch đặt hôm nay</span>
                        <span class="chat-chip" onclick="clickChatChip('Trạng thái các sân')"><i class="bi bi-hdd-stack me-1 text-success"></i>Trạng thái sân</span>
                        <span class="chat-chip" onclick="clickChatChip('Các dịch vụ đang bán')"><i class="bi bi-cart me-1 text-warning"></i>Bảng giá dịch vụ</span>
                    `;
                } else {
                    chipsContainer.innerHTML = `
                        <span class="chat-chip" onclick="clickChatChip('Sân trống tối nay')"><i class="bi bi-calendar3 me-1 text-primary"></i>Sân trống</span>
                        <span class="chat-chip" onclick="clickChatChip('Tìm nhóm ghép sân')"><i class="bi bi-people me-1 text-success"></i>Tìm bạn ghép</span>
                        <span class="chat-chip" onclick="clickChatChip('Tư vấn mua vợt')"><i class="bi bi-bag me-1 text-warning"></i>Vợt khuyên dùng</span>
                    `;
                }
            }

            if (chatMessages) {
                chatMessages.innerHTML = '';
                if (role === 'Manager') {
                    chatMessages.innerHTML = `
                        <div class="chat-message bot">
                            Xin chào Quản lý! Hệ thống đã xác thực tài khoản Admin. Tôi có thể hỗ trợ tra cứu báo cáo doanh thu, công suất khai thác sân, lịch sử vận hành nhanh qua ngôn ngữ tự nhiên.
                        </div>
                    `;
                } else if (role === 'Receptionist') {
                    chatMessages.innerHTML = `
                        <div class="chat-message bot">
                            Xin chào Lễ tân! Tôi là trợ lý ảo hỗ trợ vận hành. Tôi có thể giúp bạn kiểm tra nhanh các lịch đặt sân hôm nay, trạng thái hoạt động của các sân, bảng giá dịch vụ để phục vụ khách hàng.
                        </div>
                    `;
                } else {
                    chatMessages.innerHTML = `
                        <div class="chat-message bot">
                            Xin chào! Tôi là trợ lý ảo Aquar SmashCourt. Tôi có thể giúp bạn kiểm tra lịch sân trống, tư vấn phụ kiện thể thao phù hợp, gợi ý nhóm ghép sân.
                        </div>
                    `;
                }
            }
        }

        $(document).ready(function() {
            // Đã fix: Trích xuất an toàn giá trị từ Razor bảo vệ cú pháp JS
            const currentRole = '@userRole';
            const currentName = `@Html.Raw(userName)`;

            if (currentRole === '3') {
                switchRole('Manager', currentName);
            } else if (currentRole === '2') {
                switchRole('Receptionist', currentName);
            } else {
                switchRole('Customer', currentName);
            }
        });

        // Đổi giao diện sáng/tối
        document.addEventListener('DOMContentLoaded', function() {
            var themeToggleBtn = document.getElementById('theme-toggle');
            var themeIcon = document.getElementById('theme-icon');

            if(themeToggleBtn && themeIcon) {
                function updateIcon(theme) {
                    if(theme === 'dark') {
                        themeIcon.classList.remove('bi-moon-stars-fill');
                        themeIcon.classList.add('bi-sun-fill', 'text-warning');
                    } else {
                        themeIcon.classList.remove('bi-sun-fill', 'text-warning');
                        themeIcon.classList.add('bi-moon-stars-fill');
                    }
                }

                var currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
                updateIcon(currentTheme);

                themeToggleBtn.addEventListener('click', function() {
                    var currentTheme = document.documentElement.getAttribute('data-theme');
                    var newTheme = currentTheme === 'dark' ? 'light' : 'dark';

                    document.documentElement.setAttribute('data-theme', newTheme);
                    localStorage.setItem('theme', newTheme);
                    updateIcon(newTheme);
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
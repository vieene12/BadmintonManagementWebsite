@using System.Security.Claims
@{
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value;
    var userName = User.Identity?.Name ?? "Khách";
    var userPosition = User.FindFirst("Position")?.Value ?? "Thành viên";
    var staffCode = User.FindFirst("StaffCode")?.Value;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aquar SmashCourt</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AquarSmartCourt.styles.css" asp-append-version="true" />
    <script>
        // Init theme immediately to prevent flashing
        (function() {
            var currentTheme = localStorage.getItem('theme') || 'light';
            if (currentTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom navbar-custom py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand navbar-brand-custom" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-lightning-charge-fill"></i> Aquar SmashCourt
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarColor01">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link py-2 px-3 fw-semibold @(ViewData["ActivePage"]?.ToString() == "Customer" ? "text-primary active" : "text-secondary")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-people-fill me-1"></i> Khách Hàng
                            </a>
                        </li>
                        @if (userRole == "2" || userRole == "3")
                        {
                            <li class="nav-item">
                                <a class="nav-link py-2 px-3 fw-semibold @(ViewData["ActivePage"]?.ToString() == "Receptionist" ? "text-primary active" : "text-secondary")" asp-controller="Receptionist" asp-action="Index">
                                    <i class="bi bi-laptop me-1"></i> Quầy Lễ Tân
                                </a>
                            </li>
                        }
                        @if (userRole == "3")
                        {
                            <li class="nav-item">
                                <a class="nav-link py-2 px-3 fw-semibold @(ViewData["ActivePage"]?.ToString() == "Manager" ? "text-primary active" : "text-secondary")" asp-controller="Manager" asp-action="Index">
                                    <i class="bi bi-graph-up-arrow me-1"></i> Ban Quản Lý
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <!-- Theme Toggle Button -->
                        <button class="btn btn-link text-secondary p-0 border-0" id="theme-toggle" title="Đổi giao diện (Sáng/Tối)">
                            <i class="bi bi-moon-stars-fill fs-5" id="theme-icon"></i>
                        </button>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="text-end d-none d-sm-block">
                                <small class="text-muted d-block" style="font-size: 0.75rem;">
                                    @userPosition @(string.IsNullOrEmpty(staffCode) ? "" : $"({staffCode})")
                                </small>
                                <span class="fw-semibold text-dark" id="current-user-tag">@userName</span>
                            </div>
                            <a class="btn btn-outline-danger btn-sm rounded-pill px-3" href="@Url.Action("Logout", "Account")" style="border: 1px solid rgba(220, 38, 38, 0.25);">
                                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" href="@Url.Action("Login", "Account")">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper" style="flex: 1;">
        <div class="container-fluid px-4 py-2">
            <div class="content-area">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Premium Footer Section -->
    <footer class="mt-5 border-top" style="background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
        <div class="container-fluid px-4 py-4">
            <div class="row g-4 justify-content-between align-items-center">
                <div class="col-md-4 text-center text-md-start">
                    <a class="navbar-brand-custom text-decoration-none mb-2 d-inline-flex" href="/">
                        <i class="bi bi-lightning-charge-fill"></i> Aquar SmashCourt
                    </a>
                    <p class="text-secondary small mb-0">Nền tảng quản lý sân cầu lông thông minh cao cấp với công nghệ AI và Automation.</p>
                </div>
                <div class="col-md-4 text-center">
                    <div class="d-flex justify-content-center gap-3">
                        <a href="#" class="text-secondary text-decoration-none custom-hover"><i class="bi bi-facebook fs-5"></i></a>
                        <a href="#" class="text-secondary text-decoration-none custom-hover"><i class="bi bi-instagram fs-5"></i></a>
                        <a href="#" class="text-secondary text-decoration-none custom-hover"><i class="bi bi-youtube fs-5"></i></a>
                        <a href="#" class="text-secondary text-decoration-none custom-hover"><i class="bi bi-tiktok fs-5"></i></a>
                    </div>
                </div>
                <div class="col-md-4 text-center text-md-end text-secondary small">
                    <div class="mb-1"><i class="bi bi-envelope me-1"></i> support@aquarsmash.com</div>
                    <div><i class="bi bi-telephone me-1"></i> Hotline: 1900 8888</div>
                    <div class="mt-2 text-muted" style="font-size: 0.75rem;">&copy; 2026 Aquar Smart Court System. All rights reserved.</div>
                </div>
            </div>
        </div>
    </footer>
    
    <style>
        .custom-hover:hover { color: var(--primary-color) !important; transform: scale(1.1); transition: all 0.2s ease; display: inline-block; }
    </style>

    <!-- Nút Chatbot Toggler & Cửa sổ Chatbot chung -->
    <button class="chatbot-toggler" onclick="toggleChatbot()">
        <i class="bi bi-chat-dots-fill fs-4"></i>
    </button>

    <div class="chatbot-window glass-card" id="chatbot-window">
        <div class="chat-header">
            <div class="d-flex align-items-center gap-2">
                <div class="position-relative">
                    <i class="bi bi-robot fs-4 text-white"></i>
                    <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle" style="width: 8px; height: 8px;"></span>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Trợ Lý Aquar AI</h6>
                    <small class="opacity-75" id="chatbot-context" style="font-size: 0.72rem;">Phân hệ: Khách hàng</small>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white btn-sm" onclick="toggleChatbot()"></button>
        </div>
        <div class="chat-messages" id="chat-messages">
            <div class="chat-message bot">
                Xin chào! Tôi là trợ lý ảo Aquar SmashCourt. Tôi có thể giúp bạn kiểm tra lịch sân trống, tư vấn phụ kiện thể thao phù hợp, gợi ý nhóm ghép sân.
            </div>
        </div>
        <!-- Quick Action Suggestion Chips -->
        <div class="chat-chips-container" id="chat-chips-container">
            <span class="chat-chip" onclick="clickChatChip('Sân trống tối nay')"><i class="bi bi-calendar3 me-1 text-primary"></i>Sân trống</span>
            <span class="chat-chip" onclick="clickChatChip('Tìm nhóm ghép sân')"><i class="bi bi-people me-1 text-success"></i>Tìm bạn ghép</span>
            <span class="chat-chip" onclick="clickChatChip('Tư vấn mua vợt')"><i class="bi bi-bag me-1 text-warning"></i>Vợt khuyên dùng</span>
        </div>
        <div class="chat-input-area">
            <input type="text" class="chat-input" id="chat-input" placeholder="Nhập câu hỏi của bạn..." onkeypress="handleChatKeyPress(event)">
            <button class="chat-send-btn" onclick="sendChatMessage()">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function clickChatChip(query) {
            document.getElementById('chat-input').value = query;
            sendChatMessage();
        }

        function switchRole(role, name) {
            document.getElementById('current-user-tag').innerText = name;
            // Cập nhật phân hệ chatbot
            const contextText = role === 'Manager' ? 'Phân hệ: Quản trị (Admin)' : 'Phân hệ: Khách hàng';
            document.getElementById('chatbot-context').innerText = contextText;
            
            // Cập nhật các chip gợi ý của chatbot phù hợp với vai trò
            const chipsContainer = document.getElementById('chat-chips-container');
            if (role === 'Manager') {
                chipsContainer.innerHTML = `
                    <span class="chat-chip" onclick="clickChatChip('Báo cáo doanh thu')"><i class="bi bi-cash-coin me-1"></i>Xem doanh thu</span>
                    <span class="chat-chip" onclick="clickChatChip('Công suất sử dụng sân')"><i class="bi bi-percent me-1"></i>Công suất sân</span>
                    <span class="chat-chip" onclick="clickChatChip('Nhân viên ca trực')"><i class="bi bi-people me-1"></i>Ca trực lễ tân</span>
                `;
            } else {
                chipsContainer.innerHTML = `
                    <span class="chat-chip" onclick="clickChatChip('Sân trống tối nay')"><i class="bi bi-calendar3 me-1"></i>Sân trống</span>
                    <span class="chat-chip" onclick="clickChatChip('Tìm nhóm ghép sân')"><i class="bi bi-people me-1"></i>Tìm bạn ghép</span>
                    <span class="chat-chip" onclick="clickChatChip('Tư vấn mua vợt')"><i class="bi bi-bag me-1"></i>Vợt khuyên dùng</span>
                `;
            }

            // Xóa tin nhắn cũ và chào lại phù hợp với vai trò
            const chatMessages = document.getElementById('chat-messages');
            chatMessages.innerHTML = '';
            if (role === 'Manager') {
                chatMessages.innerHTML = `
                    <div class="chat-message bot">
                        Xin chào Quản lý! Hệ thống đã xác thực tài khoản Admin. Tôi có thể hỗ trợ tra cứu báo cáo doanh thu, công suất khai thác sân, lịch sử vận hành nhanh qua ngôn ngữ tự nhiên.
                    </div>
                `;
            } else {
                chatMessages.innerHTML = `
                    <div class="chat-message bot">
                        Xin chào! Tôi là trợ lý ảo Aquar SmashCourt. Tôi có thể giúp bạn kiểm tra lịch sân trống, tư vấn phụ kiện thể thao phù hợp, gợi ý nhóm ghép sân.
                    </div>
                `;
            }
        }

        $(document).ready(function() {
            // Initialize chatbot state based on current role on load
            const currentRole = '@userRole';
            if (currentRole === '3') {
                switchRole('Manager', '@userName');
            } else {
                switchRole('Customer', '@userName');
            }
        });
    </script>
    <script>
        // Theme toggle logic
        document.addEventListener('DOMContentLoaded', function() {
            var themeToggleBtn = document.getElementById('theme-toggle');
            var themeIcon = document.getElementById('theme-icon');
            
            function updateIcon(theme) {
                if(theme === 'dark') {
                    themeIcon.classList.remove('bi-moon-stars-fill');
                    themeIcon.classList.add('bi-sun-fill');
                    themeIcon.classList.add('text-warning');
                } else {
                    themeIcon.classList.remove('bi-sun-fill', 'text-warning');
                    themeIcon.classList.add('bi-moon-stars-fill');
                }
            }

            var currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
            updateIcon(currentTheme);

            themeToggleBtn.addEventListener('click', function() {
                var currentTheme = document.documentElement.getAttribute('data-theme');
                var newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                
                document.documentElement.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateIcon(newTheme);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

                </div>
            </div>
            <div class="modal-footer p-3 bg-light rounded-bottom-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success rounded-pill px-4" onclick="confirmPaymentAndPrint()"><i class="bi bi-check-circle me-1"></i> Đã Thu Tiền</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="quickBookModal" tabindex="-1" aria-labelledby="quickBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white py-3 rounded-top-4">
                <h5 class="modal-title fw-bold" id="quickBookModalLabel"><i class="bi bi-calendar-plus me-2"></i>Đăng Ký Đặt Sân Tại Quầy</h5>

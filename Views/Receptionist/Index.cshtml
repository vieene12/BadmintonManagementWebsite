            <div class="modal-header bg-primary text-white py-3 rounded-top-4">
                <h5 class="modal-title fw-bold" id="editCourtModalLabel"><i class="bi bi-gear-fill me-2"></i>Cấu Hình Sân Cầu Lông</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editCourtForm" onsubmit="saveCourtConfig(event)">
                <div class="modal-body p-4">
                    <input type="hidden" id="editCourtId">

                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Khung giờ hiện tại</label>
                        <input type="text" class="form-control rounded-3 bg-light" id="changeTimeRange" readonly>
                    </div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        let serviceModalObj = null;
        let checkoutModalObj = null;
        let quickBookModalObj = null;
        let editCourtModalObj = null;
        let changeCourtModalObj = null;
        let courtHourlyPrices = {
            @foreach (var court in ViewBag.Courts as List<AquarSmartCourt.Models.Court> ?? new List<AquarSmartCourt.Models.Court>())
            {
                @:@court.CourtId: @((int)court.HourlyPrice),
            }
        };

        // SignalR Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/courtHub")
            .build();

        connection.on("ReceiveUpdate", function() {
            const openModals = $('.modal.show').length;
            if (openModals === 0) {
                location.reload();
            } else {
                console.log("Dữ liệu sân đã thay đổi. Sẽ cập nhật sau.");
            }
        });

        $(document).ready(function() {
            serviceModalObj = new bootstrap.Modal(document.getElementById('serviceOrderModal'));
            checkoutModalObj = new bootstrap.Modal(document.getElementById('checkoutModal'));
            quickBookModalObj = new bootstrap.Modal(document.getElementById('quickBookModal'));
            editCourtModalObj = new bootstrap.Modal(document.getElementById('editCourtModal'));
            changeCourtModalObj = new bootstrap.Modal(document.getElementById('changeCourtModal'));
            updateServiceUnitPrice();
            loadDailyBookings();

            connection.start().then(function() {
                console.log("SignalR connected successfully.");
            }).catch(function(err) {
                console.error("SignalR connection error: " + err.toString());
            });
        });

        function openQuickBookModal(courtId, courtName, startTime, endTime) {
            if (courtId) {
                document.getElementById('quickBookCourt').value = courtId;
            } else {
                document.getElementById('quickBookCourt').selectedIndex = 0;
            }
            if (startTime) {
                document.getElementById('quickBookStart').value = startTime;
            } else {
                document.getElementById('quickBookStart').value = "17:00";
            }
            if (endTime) {
                document.getElementById('quickBookEnd').value = endTime;
            } else {
                document.getElementById('quickBookEnd').value = "19:00";
            }
            // Reset customer inputs
            document.getElementById('quickBookName').value = "";
            document.getElementById('quickBookPhone').value = "";
            document.getElementById('quickBookNotes').value = "";

            quickBookModalObj.show();
        }

        function processQuickBook(e) {
            e.preventDefault();
            const courtId = parseInt(document.getElementById('quickBookCourt').value);
            const selectEl = document.getElementById('quickBookCourt');
            const courtName = selectEl.options[selectEl.selectedIndex].getAttribute('data-name');
            const start = document.getElementById('quickBookStart').value;
            const end = document.getElementById('quickBookEnd').value;
            const name = document.getElementById('quickBookName').value;
            const phone = document.getElementById('quickBookPhone').value;

            $.ajax({
                url: '/api/CourtApi/book',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    courtId: courtId,
                    customerName: name,
                    customerPhone: phone,
                    startTime: start,
                    endTime: end
                }),
                success: function() {
                    alert(`Đăng ký đặt sân thành công!\nSân: ${courtName}\nThời gian: ${start} - ${end}\nKhách hàng: ${name}`);
                    quickBookModalObj.hide();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi đặt sân: ' + xhr.responseText);
                }
            });
        }

        function quickCheckIn(id, courtName) {
            const clientName = prompt("Nhập tên khách hàng muốn vào chơi:");
            if (clientName) {
                $.ajax({
                    url: `/api/CourtApi/${id}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        courtId: parseInt(id),
                        courtName: courtName,
                        hourlyPrice: courtHourlyPrices[id],
                        status: "InUse"
                    }),
                    success: function() {
                        alert(`Đã nhận sân và bắt đầu tính giờ!\nSân: ${courtName}\nKhách chơi: ${clientName}\nCamera sân đã kích hoạt chế độ ghi hình.`);
                        location.reload();
                    },
                    error: function(xhr) {
                        alert('Lỗi: ' + xhr.responseText);
                    }
                });
            }
        }

        function completeMaintenance(id) {
            const courtName = document.getElementById(`courtName-${id}`).innerText;
            $.ajax({
                url: `/api/CourtApi/${id}`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({
                    courtId: parseInt(id),
                    courtName: courtName,
                    hourlyPrice: courtHourlyPrices[id],
                    status: "Available"
                }),
                success: function() {
                    alert('Đã hoàn tất sửa chữa sân. Trạng thái chuyển về Đang Trống!');
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi: ' + xhr.responseText);
                }
            });
        }

        function openServiceOrderModal(court, cust, serviceFactor) {
            document.getElementById('serviceCourt').value = court;
            document.getElementById('serviceCust').value = cust;
            serviceModalObj.show();
        }

        function updateServiceUnitPrice() {
            const select = document.getElementById('orderServiceSelect');
            if (select && select.value) {
                document.getElementById('orderServicePrice').value = parseInt(select.value).toLocaleString('vi-VN') + 'đ';
            } else {
                document.getElementById('orderServicePrice').value = '0đ';
            }
        }

        function filterOrderServices() {
            const selectedCategory = document.getElementById('orderServiceCategorySelect').value;
            const serviceSelect = document.getElementById('orderServiceSelect');
            const options = serviceSelect.querySelectorAll('option');

            let firstVisibleIndex = -1;
            options.forEach((opt, idx) => {
                const cat = opt.getAttribute('data-category');
                if (selectedCategory === "All" || cat === selectedCategory) {
                    opt.style.display = '';
                    if (firstVisibleIndex === -1) {
                        firstVisibleIndex = idx;
                    }
                } else {
                    opt.style.display = 'none';
                }
            });

            if (firstVisibleIndex !== -1) {
                serviceSelect.selectedIndex = firstVisibleIndex;
            } else {
                serviceSelect.selectedIndex = -1;
            }
            updateServiceUnitPrice();
        }

        function addServiceToBill(e) {
            e.preventDefault();
            const courtName = document.getElementById('serviceCourt').value;
            const selectEl = document.getElementById('orderServiceSelect');
            const itemId = parseInt(selectEl.options[selectEl.selectedIndex].getAttribute('data-id'));
            const qty = parseInt(document.getElementById('orderServiceQty').value);
            const itemName = selectEl.options[selectEl.selectedIndex].text;

            // Map court name to ID
            let courtId = 1;
            if (courtName.includes("2")) courtId = 2;
            else if (courtName.includes("3")) courtId = 3;
            else if (courtName.includes("4")) courtId = 4;

            $.ajax({
                url: '/api/CourtApi/order',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    courtId: courtId,
                    serviceItemId: itemId,
                    quantity: qty
                }),
                success: function() {
                    alert(`Đã thêm dịch vụ thành công vào cơ sở dữ liệu!\n${itemName}\nSố lượng: ${qty}`);
                    serviceModalObj.hide();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi thêm dịch vụ: ' + xhr.responseText);
                }
            });
        }

        function openCheckoutModal(id, court, cust, hourlyPrice, hours, serviceFeeMultiplier) {
            document.getElementById('receiptCourt').innerText = court;
            document.getElementById('receiptCust').innerText = cust;
            document.getElementById('receiptDuration').innerText = `${hours} giờ`;
            document.getElementById('billCourtHours').innerText = `${hours}h`;
            
            const currentPrice = courtHourlyPrices[id] || hourlyPrice;
            const calculatedCourtFee = hours * currentPrice;
            document.getElementById('billCourtFee').innerText = `${calculatedCourtFee.toLocaleString('vi-VN')}đ`;

            // Call API to fetch actual ordered services from database
            $.ajax({
                url: `/api/CourtApi/orders/${id}`,
                type: 'GET',
                success: function(orders) {
                    let servicesHtml = '';
                    let serviceTotal = 0;
                    
                    orders.forEach(ord => {
                        servicesHtml += `
                            <tr class="service-bill-row">
                                <td class="text-dark fw-medium">${ord.itemName} (${ord.unitPrice.toLocaleString('vi-VN')}đ/${ord.unit.toLowerCase()})</td>
                                <td class="text-center">x ${ord.quantity}</td>
                                <td class="text-end fw-bold text-dark">${ord.total.toLocaleString('vi-VN')}đ</td>
                            </tr>
                        `;
                        serviceTotal += ord.total;
                    });
                    
                    // Remove any existing dynamic service rows
                    document.querySelectorAll('.service-bill-row').forEach(el => el.remove());
                    
                    // Insert before the total row (last row)
                    const totalRow = document.querySelector('#checkout-total-row');
                    $(servicesHtml).insertBefore(totalRow);
                    
                    const grandTotal = calculatedCourtFee + serviceTotal;
                    document.getElementById('billTotalAmount').innerText = `${grandTotal.toLocaleString('vi-VN')}đ`;
                    
                    // Store checkout details on modal
                    document.getElementById('checkoutModal').setAttribute('data-checkout-id', id);
                    document.getElementById('checkoutModal').setAttribute('data-court-name', court);
                    
                    checkoutModalObj.show();
                },
                error: function(xhr) {
                    alert('Lỗi tải danh sách dịch vụ: ' + xhr.responseText);
                }
            });
        }

        function confirmPaymentAndPrint() {
            const id = document.getElementById('checkoutModal').getAttribute('data-checkout-id');
            const courtName = document.getElementById('checkoutModal').getAttribute('data-court-name');
            
            // 1. Clear database active service orders for this court
            $.ajax({
                url: `/api/CourtApi/orders/${id}`,
                type: 'DELETE',
                success: function() {
                    // 2. Set court back to Available
                    $.ajax({
                        url: `/api/CourtApi/${id}`,
                        type: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            courtId: parseInt(id),
                            courtName: courtName,
                            hourlyPrice: courtHourlyPrices[id],
                            status: "Available"
                        }),
                        success: function() {
                            alert("Thanh toán thành công! Hóa đơn đã chuyển sang trạng thái [ĐÃ THANH TOÁN] và dịch vụ đã được ghi nhận ca.");
                            checkoutModalObj.hide();
                            location.reload();
                        },
                        error: function(xhr) {
                            alert('Lỗi cập nhật trạng thái sân: ' + xhr.responseText);
                        }
                    });
                },
                error: function(xhr) {
                    alert('Lỗi xóa dịch vụ hóa đơn: ' + xhr.responseText);
                }
            });
        }

        function searchCustomerInfo() {
            const phone = document.getElementById('custSearchPhone').value;
            if (phone === "0987654321") {
                document.getElementById('infoCustName').innerText = "Nguyễn Văn A";
                document.getElementById('infoCustPoints').innerText = "120 điểm";
                alert("Đã tìm thấy thông tin khách hàng thành viên!");
            } else {
                document.getElementById('infoCustName').innerText = "Khách vãng lai mới";
                document.getElementById('infoCustPoints').innerText = "0 điểm";
                alert("Số điện thoại chưa đăng ký thành viên. Hệ thống tự động tạo hồ sơ khách hàng vãng lai mới.");
            }
        }
        
        function openEditCourtModal(btn) {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            const price = btn.getAttribute('data-price');
            const status = btn.getAttribute('data-status');

            document.getElementById('editCourtId').value = id;
            document.getElementById('editCourtName').value = name;
            document.getElementById('editCourtPrice').value = price;
            document.getElementById('editCourtStatus').value = status;
            editCourtModalObj.show();
        }

        function saveCourtConfig(e) {
            e.preventDefault();
            const id = document.getElementById('editCourtId').value;
            const newName = document.getElementById('editCourtName').value;
            const newPrice = parseInt(document.getElementById('editCourtPrice').value);
            const status = document.getElementById('editCourtStatus').value;
            
            $.ajax({
                url: `/api/CourtApi/${id}`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({
                    courtId: parseInt(id),
                    courtName: newName,
                    hourlyPrice: newPrice,
                    status: status
                }),
                success: function() {
                    courtHourlyPrices[id] = newPrice;
                    alert('Cập nhật cấu hình thành công!');
                    editCourtModalObj.hide();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi: ' + xhr.responseText);
                }
            });
        }

        function loadDailyBookings() {
            $.ajax({
                url: '/api/CourtApi/schedule',
                type: 'GET',
                success: function(bookings) {
                    const tbody = document.getElementById('bookings-list-body');
                    const countBadge = document.getElementById('booking-count-badge');
                    if (!tbody) return;
                    
                    if (bookings.length === 0) {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">Không có lịch đặt nào trong ngày hôm nay.</td>
                            </tr>
                        `;
                        if (countBadge) countBadge.innerText = '0 lịch đặt';
                        return;
                    }
                    
                    if (countBadge) countBadge.innerText = `${bookings.length} lịch đặt`;
                    
                    let html = '';
                    bookings.forEach(b => {
                        const courtNameEl = document.getElementById(`courtName-${b.courtId}`);
                        const courtName = courtNameEl ? courtNameEl.innerText : `Sân ${b.courtId}`;
                        
                        html += `
                            <tr>
                                <td class="fw-semibold text-dark">${b.customerName}</td>
                                <td class="text-secondary">${b.customerPhone}</td>
                                <td><span class="badge bg-light text-dark border px-2 py-1">${courtName}</span></td>
                                <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1">${b.startTime} - ${b.endTime}</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill me-1" onclick="openChangeCourtModal(${b.bookingId}, '${b.customerName}', '${b.startTime} - ${b.endTime}', ${b.courtId})">
                                        <i class="bi bi-arrow-left-right me-1"></i>Chuyển sân
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill" onclick="cancelBooking(${b.bookingId})">
                                        <i class="bi bi-trash me-1"></i>Hủy
                                    </button>
                                </td>
                            </tr>
                        `;
                    });
                    tbody.innerHTML = html;
                },
                error: function(xhr) {
                    console.error('Lỗi tải lịch đặt sân: ', xhr.responseText);
                }
            });
        }

        function openChangeCourtModal(bookingId, customerName, timeRange, currentCourtId) {
            document.getElementById('changeBookingId').value = bookingId;
            document.getElementById('changeCustName').value = customerName;
            document.getElementById('changeTimeRange').value = timeRange;
            
            const select = document.getElementById('changeNewCourtSelect');
            select.innerHTML = '';
            
            const courts = [
                @foreach (var court in ViewBag.Courts as List<AquarSmartCourt.Models.Court> ?? new List<AquarSmartCourt.Models.Court>())
                {
                    @:{ id: @court.CourtId, name: '@Html.Raw(court.CourtName)' },
                }
            ];
            
            courts.forEach(c => {
                const option = document.createElement('option');
                option.value = c.id;
                option.text = c.name + (c.id === currentCourtId ? ' (Hiện tại)' : '');
                if (c.id === currentCourtId) {
                    option.disabled = true;
                }
                select.appendChild(option);
            });
            
            changeCourtModalObj.show();
        }

        function processChangeCourt(e) {
            e.preventDefault();
            const bookingId = parseInt(document.getElementById('changeBookingId').value);
            const newCourtId = parseInt(document.getElementById('changeNewCourtSelect').value);
            
            $.ajax({
                url: '/api/CourtApi/bookings/change-court',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    bookingId: bookingId,
                    newCourtId: newCourtId
                }),
                success: function() {
                    alert('Chuyển sân thành công!');
                    changeCourtModalObj.hide();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi chuyển sân: ' + xhr.responseText);
                }
            });
        }

        function cancelBooking(bookingId) {
            if (confirm('Bạn có chắc chắn muốn hủy lịch đặt sân này không?')) {
                $.ajax({
                    url: `/api/CourtApi/bookings/cancel/${bookingId}`,
                    type: 'POST',
                    success: function() {
                        alert('Đã hủy lịch đặt sân thành công!');
                        location.reload();
                    },
                    error: function(xhr) {
                        alert('Lỗi hủy lịch đặt sân: ' + xhr.responseText);
                    }
                });
            }
        }
    </script>
}

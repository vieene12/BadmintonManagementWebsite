// ─── 7b. Xác nhận thanh toán (có lưu vào invoiceHistory) ───
function confirmInvoicePayment() {
    const method    = invoiceState.paymentMethod === 'cash' ? 'Tiền mặt' : 'Chuyển khoản QR';
    const grandTotal = invoiceState.grandTotal || 0;

    // ─── Tạo bản ghi hóa đơn mới ───
    const courtTotal = invoiceState.hourlyPrice * invoiceState.hours;
    const fnbTotal   = invoiceState.fnbItems.reduce((s, i) => s + i.qty * i.unitPrice, 0);
    const accTotal   = invoiceState.accessoryItems.reduce((s, i) => s + i.qty * i.unitPrice, 0);
    let   discountAmt = 0;
    if (invoiceState.discountPercent > 0) {
        discountAmt = (courtTotal + fnbTotal + accTotal) * invoiceState.discountPercent / 100;
    } else {
        discountAmt = invoiceState.discount;
    }

    const newInvoice = {
        code:         '#INV-' + Date.now().toString().slice(-6),
        customerName: invoiceState.customerName || 'Khách vãng lai',
        courtName:    invoiceState.courtName,
        timeRange:    document.getElementById('inv-time-range')?.textContent || '',
        hours:        invoiceState.hours,
        courtTotal,
        fnbTotal,
        accTotal,
        discount:     discountAmt,
        grandTotal,
        method:       invoiceState.paymentMethod,
        status:       'Paid',
        createdAt:    new Date()
    };

    // Đẩy vào mảng lịch sử
    invoiceHistory.unshift(newInvoice);

    // Cập nhật bảng nếu đang hiện thị tab invoices
    renderInvoiceTable();

    // ─── TODO: Gắn API thật tại đây ───
    // fetch('/api/Invoice/Confirm', { method:'POST', body: JSON.stringify(newInvoice) })

    // Đóng modal (không reload để giữ UI mượt)
    const modalEl = document.getElementById('invoicePaymentModal');
    bootstrap.Modal.getInstance(modalEl)?.hide();

    // Hiển thị toast thông báo nhẹ nhàng
    showInvoiceToast(`✅ Đã thanh toán <strong>${fmtVND(grandTotal)}</strong> — ${newInvoice.customerName} (${newInvoice.courtName})`);
}

// ─── 8. Toast nhẹ nhàng thay thế alert ───
function showInvoiceToast(html) {
    let t = document.getElementById('inv-toast-container');
    if (!t) {
        t = document.createElement('div');
        t.id = 'inv-toast-container';
        t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:10px;';
        document.body.appendChild(t);
    }
    const toast = document.createElement('div');
    toast.style.cssText = 'background:white;border-left:4px solid #10b981;border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,0.15);padding:14px 18px;min-width:320px;max-width:400px;font-size:0.88rem;animation:slideInRight 0.3s ease;';
    toast.innerHTML = `<div class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-success"></i><span>${html}</span></div>`;
    t.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.4s'; setTimeout(() => toast.remove(), 400); }, 4000);
}

// ─── 9. Render bảng hóa đơn ───
function renderInvoiceTable() {
    const search  = (document.getElementById('inv-search-input')?.value || '').toLowerCase();
    const fStatus = document.getElementById('inv-filter-status')?.value || '';
    const fMethod = document.getElementById('inv-filter-method')?.value || '';

    // Lọc
    const filtered = invoiceHistory.filter(inv => {
        const matchSearch = !search ||
            inv.customerName.toLowerCase().includes(search) ||
            inv.courtName.toLowerCase().includes(search) ||
            inv.code.toLowerCase().includes(search);
        const matchStatus = !fStatus || inv.status === fStatus;
        const matchMethod = !fMethod || inv.method === fMethod;
        return matchSearch && matchStatus && matchMethod;
    });

    // Stats
    const allPaid    = invoiceHistory.filter(i => i.status === 'Paid');
    const allPending = invoiceHistory.filter(i => i.status === 'Pending');
    const revenue    = allPaid.reduce((s, i) => s + i.grandTotal, 0);
    document.getElementById('inv-stat-total-count').textContent   = invoiceHistory.length;
    document.getElementById('inv-stat-paid-count').textContent    = allPaid.length;
    document.getElementById('inv-stat-pending-count').textContent = allPending.length;
    document.getElementById('inv-stat-revenue').textContent       = fmtVND(revenue);
    document.getElementById('inv-table-count').textContent        = `Hiển thị ${filtered.length} hóa đơn`;

    const tbody = document.getElementById('inv-history-tbody');
    if (!tbody) return;

    if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center text-muted py-5">
            <i class="bi bi-search" style="font-size:2rem;opacity:0.3;"></i>
            <div class="mt-2">Không tìm thấy hóa đơn phù hợp.</div></td></tr>`;
        return;
    }

    const statusBadge = (s) => ({
        'Paid':      '<span class="badge rounded-pill px-2 py-1" style="background:#dcfce7;color:#15803d;font-size:0.72rem;"><i class="bi bi-check-circle-fill me-1"></i>Hoàn tất</span>',
        'Pending':   '<span class="badge rounded-pill px-2 py-1" style="background:#fef3c7;color:#92400e;font-size:0.72rem;"><i class="bi bi-clock me-1"></i>Chờ TT</span>',
        'Cancelled': '<span class="badge rounded-pill px-2 py-1" style="background:#fee2e2;color:#b91c1c;font-size:0.72rem;"><i class="bi bi-x-circle me-1"></i>Hủy</span>',
    })[s] || '<span class="badge bg-secondary">?</span>';

    const methodBadge = (m) => m === 'cash'
        ? '<span class="text-muted small"><i class="bi bi-cash-coin me-1 text-success"></i>Tiền mặt</span>'
        : '<span class="text-muted small"><i class="bi bi-qr-code me-1 text-primary"></i>Chuyển khoản</span>';

    const fmt2 = (d) => {
        const p = (n) => n.toString().padStart(2,'0');
        return `${p(d.getHours())}:${p(d.getMinutes())} ${p(d.getDate())}/${p(d.getMonth()+1)}`;
    };

    tbody.innerHTML = filtered.map((inv, idx) => `
        <tr style="font-size:0.85rem;">
            <td><code class="text-primary fw-bold" style="font-size:0.78rem;">${inv.code}</code></td>
            <td>
                <div class="fw-semibold text-dark">${inv.customerName}</div>
                <small class="text-muted">${inv.timeRange}</small>
            </td>
            <td><span class="badge rounded-pill" style="background:#eff6ff;color:#1d4ed8;">${inv.courtName}</span></td>
            <td class="text-center text-secondary">${inv.hours.toFixed(1)}h</td>
            <td class="text-end"><span class="fw-bold text-dark">${fmtVND(inv.grandTotal)}</span>
                ${inv.discount > 0 ? `<br><small class="text-success" style="font-size:0.72rem;">-${fmtVND(inv.discount)}</small>` : ''}
            </td>
            <td class="text-center">${methodBadge(inv.method)}</td>
            <td class="text-center">${statusBadge(inv.status)}</td>
            <td class="text-center text-muted" style="font-size:0.78rem;">${fmt2(inv.createdAt)}</td>
            <td class="text-center">
                <div class="d-flex gap-1 justify-content-center">
                    <button class="btn btn-outline-primary btn-sm rounded-2" style="padding:3px 8px;font-size:0.75rem;" onclick="viewInvoiceDetail(${idx})" title="Xem chi tiết">
                        <i class="bi bi-eye"></i>
                    </button>
                    ${inv.status === 'Pending' ? `<button class="btn btn-outline-success btn-sm rounded-2" style="padding:3px 8px;font-size:0.75rem;" onclick="markInvoicePaid(${idx})" title="Đánh dấu đã thanh toán"><i class="bi bi-check-lg"></i></button>` : ''}
                    ${inv.status !== 'Cancelled' ? `<button class="btn btn-outline-danger btn-sm rounded-2" style="padding:3px 8px;font-size:0.75rem;" onclick="cancelInvoice(${idx})" title="Hủy hóa đơn"><i class="bi bi-x-lg"></i></button>` : ''}
                </div>
            </td>
        </tr>`).join('');
}

// ─── 10. Xem chi tiết hóa đơn ───
function viewInvoiceDetail(filteredIdx) {
    // Lấy inv dựa trên filtered list hiện tại (ta render theo filtered)
    const search  = (document.getElementById('inv-search-input')?.value || '').toLowerCase();
    const fStatus = document.getElementById('inv-filter-status')?.value || '';
    const fMethod = document.getElementById('inv-filter-method')?.value || '';
    const filtered = invoiceHistory.filter(inv => {
        const matchSearch = !search || inv.customerName.toLowerCase().includes(search) || inv.courtName.toLowerCase().includes(search) || inv.code.toLowerCase().includes(search);
        return matchSearch && (!fStatus || inv.status === fStatus) && (!fMethod || inv.method === fMethod);
    });
    const inv = filtered[filteredIdx];
    if (!inv) return;

    const statusLabel = { 'Paid': 'Hoàn tất', 'Pending': 'Chờ TT', 'Cancelled': 'Hủy' }[inv.status] || inv.status;
    const methodLabel = inv.method === 'cash' ? 'Tiền mặt' : 'Chuyển khoản';

    const html = `
        <div class="mb-3 pb-2" style="border-bottom:1px solid #e2e8f0;">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark">${inv.code}</span>
                <small class="text-muted">${inv.createdAt.toLocaleString('vi-VN')}</small>
            </div>
        </div>
        <div class="row g-2 small mb-3">
            <div class="col-6"><span class="text-muted">Khách hàng:</span><div class="fw-semibold">${inv.customerName}</div></div>
            <div class="col-6"><span class="text-muted">Sân:</span><div class="fw-semibold text-primary">${inv.courtName}</div></div>
            <div class="col-6"><span class="text-muted">Giờ chơi:</span><div class="fw-semibold">${inv.timeRange}</div></div>
            <div class="col-6"><span class="text-muted">Hình thức:</span><div class="fw-semibold">${methodLabel}</div></div>
        </div>
        <table class="table table-sm small mb-3">
            <tbody>
                <tr><td class="text-muted">Tiền thuê sân</td><td class="text-end fw-semibold">${fmtVND(inv.courtTotal)}</td></tr>
                <tr><td class="text-muted">Dịch vụ F&B</td><td class="text-end fw-semibold">${fmtVND(inv.fnbTotal)}</td></tr>
                <tr><td class="text-muted">Thuê phụ kiện</td><td class="text-end fw-semibold">${fmtVND(inv.accTotal)}</td></tr>
                ${inv.discount > 0 ? `<tr><td class="text-success">Giảm giá / Voucher</td><td class="text-end text-success fw-semibold">-${fmtVND(inv.discount)}</td></tr>` : ''}
                <tr style="border-top:2px solid #e2e8f0;"><td class="fw-bold text-dark">THÀNH TIỀN</td><td class="text-end fw-black text-primary" style="font-size:1.1rem;">${fmtVND(inv.grandTotal)}</td></tr>
            </tbody>
        </table>
        <div class="text-center">
            <span class="badge px-3 py-2 rounded-pill" style="background:${ inv.status==='Paid' ? '#dcfce7' : inv.status==='Pending' ? '#fef3c7' : '#fee2e2' };color:${ inv.status==='Paid' ? '#15803d' : inv.status==='Pending' ? '#92400e' : '#b91c1c' };font-size:0.85rem;">${statusLabel}</span>
        </div>`;

    document.getElementById('inv-detail-body').innerHTML = html;
    new bootstrap.Modal(document.getElementById('invDetailModal')).show();
}

// ─── 11. Đánh dấu đã thanh toán ───
function markInvoicePaid(filteredIdx) {
    const search  = (document.getElementById('inv-search-input')?.value || '').toLowerCase();
    const fStatus = document.getElementById('inv-filter-status')?.value || '';
    const fMethod = document.getElementById('inv-filter-method')?.value || '';
    const filtered = invoiceHistory.filter(inv => {
        return (!search || inv.customerName.toLowerCase().includes(search) || inv.courtName.toLowerCase().includes(search) || inv.code.toLowerCase().includes(search))
            && (!fStatus || inv.status === fStatus) && (!fMethod || inv.method === fMethod);
    });
    const inv = filtered[filteredIdx];
    if (inv) { inv.status = 'Paid'; renderInvoiceTable(); showInvoiceToast(`✅ Đã cập nhật <strong>${inv.code}</strong> sang Hoàn tất`); }
}

// ─── 12. Hủy hóa đơn ───
function cancelInvoice(filteredIdx) {
    if (!confirm('Bạn có chắc muốn hủy hóa đơn này không?')) return;
    const search  = (document.getElementById('inv-search-input')?.value || '').toLowerCase();
    const fStatus = document.getElementById('inv-filter-status')?.value || '';
    const fMethod = document.getElementById('inv-filter-method')?.value || '';
    const filtered = invoiceHistory.filter(inv => {
        return (!search || inv.customerName.toLowerCase().includes(search) || inv.courtName.toLowerCase().includes(search) || inv.code.toLowerCase().includes(search))
            && (!fStatus || inv.status === fStatus) && (!fMethod || inv.method === fMethod);
    });
    const inv = filtered[filteredIdx];
    if (inv) { inv.status = 'Cancelled'; renderInvoiceTable(); showInvoiceToast(`Hóa đơn <strong>${inv.code}</strong> đã bị hủy`); }
}

// ─── 13. Xuất CSV ───
function exportInvoiceCSV() {
    const header = ['Mã HĐ','Khách hàng','Sân','Giờ chơi','Tiền sân','F&B','Phụ kiện','Giảm giá','Thành tiền','Hình thức','Trạng thái','Thời gian'];
    const rows = invoiceHistory.map(inv => [
        inv.code, inv.customerName, inv.courtName, inv.timeRange,
        inv.courtTotal, inv.fnbTotal, inv.accTotal, inv.discount, inv.grandTotal,
        inv.method === 'cash' ? 'Tiền mặt' : 'Chuyển khoản',
        { 'Paid': 'Hoàn tất', 'Pending': 'Chờ TT', 'Cancelled': 'Hủy' }[inv.status] || inv.status,
        inv.createdAt.toLocaleString('vi-VN')
    ]);
    const csv = [header, ...rows].map(r => r.map(v => `"${String(v).replace(/"/g,'""')}"`).join(',')).join('\n');
    const a = document.createElement('a');
    a.href = 'data:text/csv;charset=utf-8,\uFEFF' + encodeURIComponent(csv);
    a.download = `HoaDon_Ca_${new Date().toLocaleDateString('vi-VN').replace(/\//g,'-')}.csv`;
    a.click();
}

// ─── 14. Chuyển sang tab quản lý hóa đơn ───
function switchToInvoiceTab() {
    // Nếu có tab system dùng admin-tab-content, ẩn các tab khác và hiển thị tab invoices
    const allTabs = document.querySelectorAll('.admin-tab-content');
    allTabs.forEach(t => t.style.display = 'none');
    const invTab = document.getElementById('tab-invoices');
    if (invTab) {
        invTab.style.display = '';
        invTab.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    renderInvoiceTable();
}


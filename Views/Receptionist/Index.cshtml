@{
    ViewData["Title"] = "Quầy Lễ Tân - Nghiệp Vụ Tại Quầy";
    ViewData["ActivePage"] = "Receptionist";
}
<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark" style="letter-spacing: -1px;"><i class="bi bi-laptop me-2 text-primary"></i>Quầy Lễ Tân (Receptionist Hub)</h2>
            <p class="text-secondary mb-0">Quản lý đặt sân tại quầy, kích hoạt ca chơi, bán dịch vụ gia tăng và thanh toán hóa đơn.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-quick-book rounded-pill px-4" onclick="openQuickBookModal()">
                <i class="bi bi-plus-circle me-1"></i> Đặt Sân Tại Quầy
            </button>
            <button class="btn btn-outline-warning rounded-pill px-3" onclick="switchToInvoiceTab()" style="background:white;">
                <i class="bi bi-receipt me-1"></i> Quản lý Hóa Đơn
            </button>
            <button class="btn btn-outline-secondary rounded-pill px-3" onclick="location.reload()" style="background: white;">
                <i class="bi bi-arrow-clockwise"></i> Đồng Bộ Lịch
            </button>
        </div>
    </div>
    <!-- Tab: Realtime Court Status & Daily Bookings -->
    <div id="tab-courts" class="admin-tab-content active">
        <!-- Trạng Thái Sân Thời Gian Thực -->
        <div class="glass-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Trạng Thái Sân Thời Gian Thực</h5>
                    <small class="text-muted">Ca trực hiện tại: Hoạt động ổn định</small>
                </div>

                <div class="row g-3" id="court-status-container">
                    @foreach (var court in ViewBag.Courts as List<AquarSmartCourt.Models.Court> ?? new List<AquarSmartCourt.Models.Court>())
                    {
                        var now = DateTime.Now;
                        var activeBooking = (ViewBag.TodayBookings as List<AquarSmartCourt.Models.Booking>)?.FirstOrDefault(b =>
                            b.CourtId == court.CourtId &&
                            b.StartTime <= now &&
                            now <= b.EndTime
                        );
                        string computedStatus = court.Status;
                        if (court.Status == "Available" && activeBooking != null)
                        {
                            computedStatus = "InUse";
                        }
                        string statusClass = computedStatus.ToLower() switch
                        {
                            "inuse" => "status-in-use",
                            "available" => "status-available",
                            "maintenance" => "status-maintenance",
                            _ => "status-available"
                        };
                        <div class="col-md-6" id="court-card-col-@court.CourtId">
                            <div class="card border-0 glass-card court-card @statusClass p-3 glow-card">
                                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <h5 class="fw-bold text-dark mb-0" id="courtName-@court.CourtId" style="font-weight: 800;">@court.CourtName</h5>
                                        <button class="btn btn-link p-0 text-muted btn-edit-court"
                                                data-id="@court.CourtId"
                                                data-name="@court.CourtName"
                                                data-price="@((int)court.HourlyPrice)"
                                                data-status="@court.Status"
                                                onclick="openEditCourtModal(this)"
                                                title="Cấu hình giá sân">
                                            <i class="bi bi-gear-fill"></i>
                                        </button>
                                    </div>
                                    @if (computedStatus == "InUse")
                                    {
                                        <span class="status-badge in-use"><i class="bi bi-activity"></i> Đang Sử Dụng</span>
                                    }
                                    else if (computedStatus == "Maintenance")
                                    {
                                        <span class="status-badge maintenance"><i class="bi bi-wrench"></i> Đang Bảo Trì</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge available"><i class="bi bi-check-circle-fill"></i> Đang Trống</span>
                                    }
                                </div>
                                <div class="svg-court-container">
                                    <svg width="240" height="80" viewBox="0 0 240 80">
                                        @{
                                            string svgBg = computedStatus == "InUse" ? "rgba(99, 102, 241, 0.2)" :
                                                           computedStatus == "Maintenance" ? "rgba(244, 63, 94, 0.15)" :
                                                           "rgba(16, 185, 129, 0.2)";
                                        }
                                        <rect x="10" y="5" width="220" height="70" fill="@svgBg" rx="6" />
                                        <rect x="10" y="5" width="220" height="70" class="svg-court-lines" />
                                        <line x1="120" y1="5" x2="120" y2="75" class="svg-court-lines" />
                                        <line x1="120" y1="5" x2="120" y2="75" class="svg-court-net" />
                                        <line x1="85" y1="5" x2="85" y2="75" class="svg-court-lines" />
                                        <line x1="155" y1="5" x2="155" y2="75" class="svg-court-lines" />
                                        <line x1="10" y1="40" x2="85" y2="40" class="svg-court-lines" />
                                        <line x1="155" y1="40" x2="230" y2="40" class="svg-court-lines" />
                                    </svg>

                                    <div class="position-absolute top-0 end-0 m-2 small font-monospace text-muted" style="font-size: 0.65rem;">
                                        @if (computedStatus == "InUse")
                                        {
                                            <span class="text-primary fw-bold"><i class="bi bi-camera-video"></i> REC</span>
                                        }
                                        else if (computedStatus == "Maintenance")
                                        {
                                            <span class="text-danger fw-bold"><i class="bi bi-shield-slash"></i> OFF</span>
                                        }
                                        else
                                        {
                                            <span class="text-success fw-bold"><i class="bi bi-check-circle"></i> RDY</span>
                                        }
                                    </div>
                                </div>
                                @if (computedStatus == "InUse" && activeBooking != null)
                                {
                                    var customerName = activeBooking.CustomerName;
                                    var customerPhone = activeBooking.CustomerPhone;
                                    var timeRange = $"{activeBooking.StartTime.ToString("HH:mm")} - {activeBooking.EndTime.ToString("HH:mm")}";
                                    var hours = (activeBooking.EndTime - activeBooking.StartTime).TotalHours;
                                    if (hours <= 0) hours = 1.0;
                                    var svcMultiplier = court.CourtId == 1 ? 0.5 : 1.0;
                                    <table class="table table-sm table-borderless mb-3 small text-secondary">
                                        <tbody>
                                            <tr>
                                                <td style="width: 35%;" class="fw-semibold text-muted">Khách chơi:</td>
                                                <td class="text-dark fw-bold">@customerName</td>
                                            </tr>
                                            <tr>
                                                <td class="fw-semibold text-muted">Số điện thoại:</td>
                                                <td class="text-dark">@customerPhone</td>
                                            </tr>
                                            <tr>
                                                <td class="fw-semibold text-muted">Khung giờ:</td>
                                                <td class="text-dark"><span class="badge bg-light text-dark border rounded-pill px-2">@timeRange</span></td>
                                            </tr>
                                            <tr>
                                                <td class="fw-semibold text-muted">Camera:</td>
                                                <td>
                                                    <span class="recording-indicator"><span class="recording-dot"></span> Ghi hình trực tiếp</span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-outline-primary btn-sm flex-fill rounded-pill py-2" onclick="openServiceOrderModal('@court.CourtName', '@customerName', @svcMultiplier)"><i class="bi bi-cart-plus me-1"></i>Gọi Nước/Vợt</button>
                                        <button class="btn btn-primary btn-sm flex-fill rounded-pill py-2" onclick="openCheckoutModal(@court.CourtId, '@court.CourtName', '@customerName', @((int)court.HourlyPrice), @hours, @svcMultiplier)"><i class="bi bi-cash-coin me-1"></i>Tính Tiền</button>
                                    </div>
                                }
                                else if (computedStatus == "Maintenance")
                                {
                                    <div class="alert alert-danger border-0 rounded-4 p-3 mb-3 text-center text-danger small">
                                        <i class="bi bi-exclamation-triangle-fill fs-4 d-block mb-1"></i>
                                        Sân đang tạm khóa để bảo trì.
                                    </div>
                                    <button class="btn btn-outline-secondary btn-sm w-100 rounded-pill py-2" onclick="completeMaintenance(@court.CourtId)">
                                        <i class="bi bi-check2"></i> Xác Nhận Bảo Trì Xong
                                    </button>
                                }
                                else
                                {
                                    <table class="table table-sm table-borderless mb-3 small text-secondary">
                                        <tbody>
                                            <tr>
                                                <td style="width: 35%;" class="fw-semibold text-muted">Đơn giá sân:</td>
                                                <td class="text-success fw-bold"><span class="court-price-label-@court.CourtId">@(((int)court.HourlyPrice).ToString("N0", new System.Globalization.CultureInfo("vi-VN")))đ</span> / giờ</td>
                                            </tr>
                                            <tr>
                                                <td class="fw-semibold text-muted">Lịch chơi tiếp:</td>
                                                <td class="text-dark">Trống trong 2 giờ tới</td>
                                            </tr>
                                            <tr>
                                                <td class="fw-semibold text-muted">Trạng thái:</td>
                                                <td>Sẵn sàng đón khách nhận sân</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <button class="btn btn-success btn-sm w-100 rounded-pill py-2" onclick="openQuickBookModal(@court.CourtId, '@court.CourtName')">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Vào Chơi Trực Tiếp
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="glass-card p-4 mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-calendar3 me-2 text-primary"></i>Lịch Đặt Sân Trong Ngày</h5>
                    <span class="badge bg-primary rounded-pill px-3" id="booking-count-badge">0 lịch đặt</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0" id="bookings-table">
                        <thead class="table-light">
                            <tr class="small text-secondary">
                                <th>Khách hàng</th>
                                <th>Số điện thoại</th>
                                <th>Sân</th>
                                <th>Khung giờ</th>
                                <th class="text-end" style="width: 220px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="bookings-list-body" class="small">
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">Đang tải danh sách lịch đặt...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
        </div>
    </div> <!-- end tab-courts -->

    <!-- Tab: Hourly Grid Schedule -->
    <div id="tab-schedule" class="admin-tab-content">
        <!-- Sơ Đồ Đặt Sân Theo Khung Giờ (Hôm Nay) -->
        <div class="glass-card p-4 mt-0 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold text-dark mb-1"><i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Sơ Đồ Đặt Sân Theo Khung Giờ (Hôm Nay)</h5>
                        <small class="text-muted">Nhấp vào ô trống màu xanh để hỗ trợ đặt sân và tư vấn khung giờ cho khách tại quầy</small>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="status-badge available" style="font-size: 0.65rem;"><i class="bi bi-check-circle-fill"></i> Trống</span>
                        <span class="status-badge maintenance" style="background: rgba(244, 63, 94, 0.1); color: var(--accent-danger-dark); border-color: rgba(244, 63, 94, 0.2); font-size: 0.65rem;"><i class="bi bi-wrench"></i> Bảo trì</span>
                        <span class="status-badge in-use" style="font-size: 0.65rem; background: rgba(99, 102, 241, 0.1); color: var(--primary-color); border-color: rgba(99, 102, 241, 0.2);"><i class="bi bi-lock-fill"></i> Đã đặt</span>
                    </div>
                </div>
                <div class="timetable-container">
                    <table class="timetable-table">
                        <thead>
                            <tr>
                                <th>Khung Giờ</th>
                                @foreach (var court in ViewBag.Courts as List<AquarSmartCourt.Models.Court> ?? new List<AquarSmartCourt.Models.Court>())
                                {
                                    <th>
                                        @court.CourtName
                                        @if (court.Status == "Maintenance")
                                        {
                                            <br /><small class="text-danger" style="font-size: 0.65rem; text-transform: none;"><i class="bi bi-wrench"></i> Bảo trì</small>
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var slots = new List<(string Start, string End)>
                                {
                                    ("05:00", "06:00"), ("06:00", "07:00"), ("07:00", "08:00"),
                                    ("08:00", "09:00"), ("09:00", "10:00"), ("10:00", "11:00"),
                                    ("11:00", "12:00"), ("12:00", "13:00"), ("13:00", "14:00"),
                                    ("14:00", "15:00"), ("15:00", "16:00"), ("16:00", "17:00"),
                                    ("17:00", "18:00"), ("18:00", "19:00"), ("19:00", "20:00"),
                                    ("20:00", "21:00"), ("21:00", "22:00")
                                };
                                var courts = ViewBag.Courts as List<AquarSmartCourt.Models.Court> ?? new List<AquarSmartCourt.Models.Court>();
                                var todayBookings = ViewBag.TodayBookings as List<AquarSmartCourt.Models.Booking> ?? new List<AquarSmartCourt.Models.Booking>();
                            }
                            @foreach (var slot in slots)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@slot.Start - @slot.End</td>
                                    @foreach (var court in courts)
                                    {
                                        var startParts = slot.Start.Split(':');
                                        var endParts = slot.End.Split(':');
                                        var slotStart = DateTime.Today.AddHours(int.Parse(startParts[0])).AddMinutes(int.Parse(startParts[1]));
                                        var slotEnd = DateTime.Today.AddHours(int.Parse(endParts[0])).AddMinutes(int.Parse(endParts[1]));
                                        var booking = todayBookings.FirstOrDefault(b =>
                                            b.CourtId == court.CourtId &&
                                            b.StartTime < slotEnd &&
                                            slotStart < b.EndTime
                                        );
                                        if (court.Status == "Maintenance")
                                        {
                                            <td class="maintenance text-danger text-center bg-danger-subtle fw-semibold" style="cursor: not-allowed;" onclick="alert('Sân này đang trong thời gian bảo trì!')">
                                                <i class="bi bi-wrench me-1"></i> Bảo trì
                                            </td>
                                        }
                                        else if (booking != null)
                                        {
                                            <td class="bg-light text-muted fw-semibold text-center" style="cursor: pointer; border-left: 3px solid var(--primary-color) !important;" onclick="alert('Khách hàng: @(booking.CustomerName)\nSĐT: @(booking.CustomerPhone)\nKhung giờ: @(booking.StartTime.ToString("HH:mm")) - @(booking.EndTime.ToString("HH:mm"))')">
                                                <i class="bi bi-person-fill me-1 text-primary"></i> @booking.CustomerName
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="empty text-success" onclick="openQuickBookModal(@court.CourtId, '@court.CourtName', '@slot.Start', '@slot.End')" style="cursor: pointer;">
                                                <i class="bi bi-plus-circle-fill me-1"></i> Trống (Đặt sân)
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
        </div>
    </div> <!-- end tab-schedule -->

    <!-- Tab: Customer Directory -->
    <div id="tab-customers" class="admin-tab-content">
        <!-- Tra Cứu Khách Hàng -->
        <div class="glass-card p-4 mt-0 mb-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-search me-2 text-primary"></i>Tra Cứu Khách Hàng</h5>
                <div class="input-group mb-3">
                    <input type="text" class="form-control rounded-start-pill" id="custSearchPhone" placeholder="Nhập số điện thoại (0987...)" value="0987654321">
                    <button class="btn btn-primary rounded-end-pill px-3" type="button" onclick="searchCustomerInfo()"><i class="bi bi-search"></i></button>
                </div>

                <div class="border rounded-4 p-3 bg-light" id="customer-info-box" style="border-left: 4px solid var(--accent-warning) !important;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0" id="infoCustName"><i class="bi bi-person-fill me-1"></i> Nguyễn Văn A</h6>
                        <span class="badge bg-warning text-dark fw-bold" style="font-size: 0.7rem;">Thành Viên Gold</span>
                    </div>
                    <hr class="my-2 bg-secondary opacity-25">
                    <div class="small text-secondary vstack gap-1">
                        <div class="d-flex justify-content-between">
                            <span>Số điện thoại:</span>
                            <span class="text-dark fw-medium" id="infoCustPhone">0987654321</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Điểm tích lũy:</span>
                            <span class="text-primary fw-bold" id="infoCustPoints">120 điểm</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Lịch sử sử dụng:</span>
                            <span class="text-dark">12 lượt chơi | 34 dịch vụ</span>
                        </div>
                    </div>
                </div>
        </div>
    </div> <!-- end tab-customers -->

    <!-- Tab: Shift Auditing -->
    <div id="tab-shift" class="admin-tab-content">
        <!-- Kiểm Kê Doanh Thu Ca -->
        <div class="glass-card p-4 mb-4 border-start border-4 border-success bg-white mt-0 glow-card">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-wallet2 me-2 text-success"></i>Kiểm Kê Doanh Thu Ca</h5>
                <p class="text-secondary small mb-3">Đối chiếu tổng tiền thuê sân và dịch vụ phát sinh thực tế tại quầy.</p>
                <div class="vstack gap-2 mb-3 border rounded-3 p-3 audit-log-box">
                    <div class="d-flex justify-content-between border-bottom pb-1 mb-1 small">
                        <span class="text-secondary fw-medium">Tiền thuê sân đã thu:</span>
                        <strong class="text-dark">2.400.000đ</strong>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-1 mb-1 small">
                        <span class="text-secondary fw-medium">Tiền nước & dịch vụ:</span>
                        <strong class="text-dark">850.000đ</strong>
                    </div>
                    <div class="d-flex justify-content-between pb-1">
                        <span class="text-secondary fw-bold text-dark">Tổng thu thực tế:</span>
                        <strong class="text-success fs-5 fw-extrabold" style="font-weight: 800;">3.250.000đ</strong>
                    </div>
                </div>
                <button class="btn btn-success btn-sm w-100 rounded-pill py-2 fw-bold" onclick="alert('Báo cáo kiểm kê ca đã được ghi nhận vào hệ thống quản trị và in thành công!')">
                    <i class="bi bi-printer-fill me-1"></i> Chốt Ca & In Bàn Giao
                </button>
        </div>
    </div> <!-- end tab-shift -->

    <!-- Tab: Service Pricing -->
    <div id="tab-services" class="admin-tab-content">
        <!-- Bảng Giá Dịch Vụ -->
        <div class="glass-card p-4 mt-0 mb-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-tags me-2 text-primary"></i>Bảng Giá Dịch Vụ</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle small mb-0">
                        <thead>
                            <tr class="table-light">
                                <th style="width: 60px;">Ảnh</th>
                                <th>Tên Dịch Vụ</th>
                                <th class="text-center">ĐVT</th>
                                <th class="text-end">Đơn Giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.Services as List<AquarSmartCourt.Models.ServiceItem> ?? new List<AquarSmartCourt.Models.ServiceItem>())
                            {
                                <tr>
                                    <td>
                                        <div class="service-image-preview-cell" data-service-id="@item.ServiceItemId" style="width: 40px; height: 28px; background: #e2e8f0; border-radius: 2px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-image text-muted" style="font-size: 0.8rem;"></i>
                                        </div>
                                    </td>
                                    <td class="fw-medium text-dark">@item.ItemName</td>
                                    <td class="text-center text-muted">@item.Unit</td>
                                    <td class="text-end fw-bold text-dark">@(((int)item.UnitPrice).ToString("N0", new System.Globalization.CultureInfo("vi-VN")))đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
        </div>
    </div> <!-- end tab-services -->

    <!-- ===============================================================
         Tab: Quản lý Hóa Đơn (Invoice Management)
         =============================================================== -->
    <div id="tab-invoices" class="admin-tab-content">
        <div class="glass-card p-4 mt-0 mb-4">

            <!-- Header row -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h5 class="fw-bold text-dark mb-1"><i class="bi bi-receipt me-2 text-primary"></i>Quản lý Hóa Đơn</h5>
                    <small class="text-muted">Tất cả hóa đơn thanh toán được ghi nhận trong ca trực hôm nay.</small>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-outline-success btn-sm rounded-pill px-3" onclick="exportInvoiceCSV()">
                        <i class="bi bi-download me-1"></i>Xuất Excel
                    </button>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="renderInvoiceTable()">
                        <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
                    </button>
                </div>
            </div>

            <!-- Summary stat cards -->
            <div class="row g-3 mb-4" id="inv-stat-cards">
                <div class="col-6 col-md-3">
                    <div class="rounded-3 p-3 text-center" style="background:#eff6ff;border:1px solid #bfdbfe;">
                        <div class="fw-black text-primary" style="font-size:1.6rem;" id="inv-stat-total-count">0</div>
                        <small class="text-secondary">Tổng hóa đơn</small>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="rounded-3 p-3 text-center" style="background:#f0fdf4;border:1px solid #bbf7d0;">
                        <div class="fw-black text-success" style="font-size:1.6rem;" id="inv-stat-paid-count">0</div>
                        <small class="text-secondary">Hoàn tất</small>
                    </div>
                </div>

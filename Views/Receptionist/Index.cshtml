<!-- ─── Inline Script for Invoice Logic ─── -->
<script>
// ================================================================
// INVOICE PAYMENT LOGIC
// Được gọi từ nút "Tính Tiền" trong khối trạng thái sân
// ================================================================

// ─── 1. State object lưu dữ liệu phiên làm việc hiện tại ───
const invoiceState = {
    courtId: null,
    courtName: '',
    customerName: '',
    hourlyPrice: 0,
    hours: 0,
    discount: 0,          // Số tiền giảm (VNĐ)
    discountPercent: 0,   // % giảm
    paymentMethod: 'cash',

    // ─── Mock data dịch vụ đã gọi trong phiên ───
    // Khi gắn API thật: thay thế bằng fetch('/api/SessionOrders?bookingId=...')
    fnbItems: [
        { name: 'Nước Aquafina 500ml', qty: 3, unitPrice: 10000 },
        { name: 'Pocari Sweat Ion',     qty: 2, unitPrice: 15000 },
        { name: 'Snack Lays (gói lớn)',qty: 1, unitPrice: 25000 },
    ],
    accessoryItems: [
        { name: 'Thuê vợt Victor NR10', qty: 2, unitPrice: 30000 },
        { name: 'Ống cầu Ba Sao',       qty: 1, unitPrice: 55000 },
    ],

    // Danh sách voucher hợp lệ (mock) - thay bằng API khi cần
    validVouchers: {
        'SMASH10':   { type: 'percent', value: 10,   label: 'Giảm 10%' },
        'WELCOME20': { type: 'percent', value: 20,   label: 'Giảm 20% cho khách mới' },
        'FLAT50K':   { type: 'fixed',   value: 50000, label: 'Giảm 50.000đ' },
        'VIP100K':   { type: 'fixed',   value: 100000,label: 'Giảm 100.000đ (VIP)' },
    }
};

// ─── 2. Hàm format tiền VNĐ ───
function fmtVND(amount) {
    return Math.max(0, Math.round(amount)).toLocaleString('vi-VN') + 'đ';
}

// ─── 3. Mở modal và render dữ liệu ───
function openCheckoutModal(courtId, courtName, customerName, hourlyPrice, hours, svcMultiplier) {
    // Cập nhật state
    invoiceState.courtId      = courtId;
    invoiceState.courtName    = courtName;
    invoiceState.customerName = customerName;
    invoiceState.hourlyPrice  = hourlyPrice;
    invoiceState.hours        = hours;
    invoiceState.discount     = 0;
    invoiceState.discountPercent = 0;
    invoiceState.paymentMethod   = 'cash';

    // Reset voucher UI
    const voucherInput = document.getElementById('inv-voucher-input');
    const voucherMsg   = document.getElementById('inv-voucher-message');
    if (voucherInput) voucherInput.value = '';
    if (voucherMsg)   voucherMsg.innerHTML = '';

    // Reset payment method UI
    selectPaymentMethod('cash');

    // ─── Render thông tin khách hàng ───
    document.getElementById('inv-customer-name').textContent  = customerName || 'Khách vãng lai';
    document.getElementById('inv-customer-phone').textContent = '(Xem tại hệ thống)';
    document.getElementById('inv-court-name').textContent     = courtName;

    // Mock time range: bắt đầu = giờ hiện tại, kết thúc = + hours
    const now   = new Date();
    const end   = new Date(now.getTime() + hours * 3600 * 1000);
    const fmt   = (d) => d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');
    document.getElementById('inv-time-range').textContent = fmt(now) + ' – ' + fmt(end);

    // Mã hoá đơn mock
    const invoiceCode = '#INV-' + Date.now().toString().slice(-6);
    document.getElementById('inv-invoice-code').textContent    = 'Mã HĐ: ' + invoiceCode;
    document.getElementById('inv-bank-content').textContent    = 'HĐ ' + invoiceCode;

    // ─── Render Group 1: Tiền thuê sân ───
    const courtBody = document.getElementById('inv-court-rows');
    const courtTotal = hourlyPrice * hours;
    courtBody.innerHTML = `
        <tr>
            <td class="fw-semibold">${courtName}</td>
            <td class="text-center">${hours.toFixed(1)}h</td>
            <td class="text-end">${fmtVND(hourlyPrice)}</td>
            <td class="text-end fw-bold text-primary">${fmtVND(courtTotal)}</td>
        </tr>`;

    // ─── Render Group 2: F&B ───
    const fnbBody = document.getElementById('inv-fnb-rows');
    if (invoiceState.fnbItems.length === 0) {
        fnbBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-2">Không có gọi dịch vụ F&B</td></tr>';
    } else {
        fnbBody.innerHTML = invoiceState.fnbItems.map(item => {
            const lineTotal = item.qty * item.unitPrice;
            return `<tr>
                <td>${item.name}</td>
                <td class="text-center">${item.qty}</td>
                <td class="text-end">${fmtVND(item.unitPrice)}</td>
                <td class="text-end fw-semibold text-success">${fmtVND(lineTotal)}</td>
            </tr>`;
        }).join('');
    }

    // ─── Render Group 3: Phụ kiện ───
    const accBody = document.getElementById('inv-accessory-rows');
    if (invoiceState.accessoryItems.length === 0) {
        accBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-2">Không có thuê phụ kiện</td></tr>';
    } else {
        accBody.innerHTML = invoiceState.accessoryItems.map(item => {
            const lineTotal = item.qty * item.unitPrice;
            return `<tr>
                <td>${item.name}</td>
                <td class="text-center">${item.qty}</td>
                <td class="text-end">${fmtVND(item.unitPrice)}</td>
                <td class="text-end fw-semibold" style="color:#92400e;">${fmtVND(lineTotal)}</td>
            </tr>`;
        }).join('');
    }

    // Tính tổng và render
    recalculateTotals();

    // Mở modal Bootstrap
    const modalEl = document.getElementById('invoicePaymentModal');
    const bsModal = new bootstrap.Modal(modalEl);
    bsModal.show();
}

// ─── 4. Tính toán và cập nhật tổng tiền ───
function recalculateTotals() {
    // Tổng tiền thuê sân
    const courtTotal = invoiceState.hourlyPrice * invoiceState.hours;

    // Tổng F&B
    const fnbTotal = invoiceState.fnbItems.reduce((s, i) => s + i.qty * i.unitPrice, 0);

    // Tổng phụ kiện
    const accTotal = invoiceState.accessoryItems.reduce((s, i) => s + i.qty * i.unitPrice, 0);

    // Tổng chưa giảm
    const subtotal = courtTotal + fnbTotal + accTotal;

    // Tính giảm giá
    let discount = 0;
    if (invoiceState.discountPercent > 0) {
        discount = subtotal * invoiceState.discountPercent / 100;
    } else if (invoiceState.discount > 0) {
        discount = invoiceState.discount;
    }
    discount = Math.min(discount, subtotal); // Không giảm quá tổng tiền

    const grandTotal = subtotal - discount;

    // ─── Cập nhật UI ───
    document.getElementById('inv-subtotal-court').textContent     = fmtVND(courtTotal);
    document.getElementById('inv-subtotal-fnb').textContent       = fmtVND(fnbTotal);
    document.getElementById('inv-subtotal-accessory').textContent = fmtVND(accTotal);
    document.getElementById('inv-subtotal-all').textContent       = fmtVND(subtotal);
    document.getElementById('inv-discount-display').textContent   = '-' + fmtVND(discount);
    document.getElementById('inv-grand-total').textContent        = fmtVND(grandTotal);

    // Lưu grand total để dùng khi confirm
    invoiceState.grandTotal = grandTotal;
}

// ─── 5. Xử lý mã voucher ───
function applyVoucher() {
    const code    = (document.getElementById('inv-voucher-input').value || '').trim().toUpperCase();
    const msgEl   = document.getElementById('inv-voucher-message');
    const voucher = invoiceState.validVouchers[code];

    if (!code) {
        // Reset discount
        invoiceState.discount        = 0;
        invoiceState.discountPercent = 0;
        msgEl.innerHTML = '';
        recalculateTotals();
        return;
    }

    if (!voucher) {
        msgEl.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Mã voucher không hợp lệ hoặc đã hết hạn.</span>';
        invoiceState.discount        = 0;
        invoiceState.discountPercent = 0;
        recalculateTotals();
        return;
    }

    // Áp dụng voucher
    if (voucher.type === 'percent') {
        invoiceState.discountPercent = voucher.value;
        invoiceState.discount        = 0;
        msgEl.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i>${voucher.label} đã được áp dụng!</span>`;
    } else {
        invoiceState.discount        = voucher.value;
        invoiceState.discountPercent = 0;
        msgEl.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i>${voucher.label} đã được áp dụng!</span>`;
    }

    recalculateTotals();
}

// ─── 6. Chọn phương thức thanh toán ───

<div class="modal fade" id="changeCourtModal" tabindex="-1" aria-labelledby="changeCourtModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white py-3 rounded-top-4">
                <h5 class="modal-title fw-bold" id="changeCourtModalLabel"><i class="bi bi-arrow-left-right me-2"></i>Chuyển Sân Cho Khách Hàng</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="changeCourtForm" onsubmit="processChangeCourt(event)">
                <div class="modal-body p-4">
                    <input type="hidden" id="changeBookingId">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Khách hàng</label>

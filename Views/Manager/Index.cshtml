                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: #ffffff; color: #1e293b;">
                            <div class="modal-header border-0 pb-0" style="padding: 1.5rem 1.5rem 0.5rem 1.5rem; background: #ffffff !important; color: #161616 !important;">

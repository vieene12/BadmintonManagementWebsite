@section Scripts {
    <!-- ExcelJS Library for exporting premium xlsx files from frontend -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>

    <!-- Load weekly revenue mock data module -->
    <script type="module">
        import { weeklyRevenue } from '/js/mockData.js';
        window.weeklyRevenueMock = weeklyRevenue;
    </script>

    <script>
        let addStaffModalObj = null;
        let promoteStaffModalObj = null;
        let adminEditCourtModalObj = null;
        let adminAddCourtModalObj = null;
        let adminAddServiceModalObj = null;
        let adminEditServiceModalObj = null;
        let uploadImageModalObj = null;
        let adminCourtPrices = {
            @foreach (var court in ViewBag.Courts as List<AquarSmartCourt.Models.Court> ?? new List<AquarSmartCourt.Models.Court>())
            {
                @:@court.CourtId: @((int)court.HourlyPrice),
            }
        };

        $(document).ready(function() {
            addStaffModalObj = new bootstrap.Modal(document.getElementById('addStaffModal'));
            promoteStaffModalObj = new bootstrap.Modal(document.getElementById('promoteStaffModal'));
            adminEditCourtModalObj = new bootstrap.Modal(document.getElementById('adminEditCourtModal'));
            adminAddCourtModalObj = new bootstrap.Modal(document.getElementById('adminAddCourtModal'));
            adminAddServiceModalObj = new bootstrap.Modal(document.getElementById('adminAddServiceModal'));
            adminEditServiceModalObj = new bootstrap.Modal(document.getElementById('adminEditServiceModal'));
            uploadImageModalObj = new bootstrap.Modal(document.getElementById('uploadImageModal'));

            // Load base64 images from localStorage into court cells
            document.querySelectorAll('.court-image-preview-cell').forEach(el => {
                const id = el.getAttribute('data-court-id');
                const base64 = localStorage.getItem(`court_img_${id}`);
                if (base64) {
                    el.innerHTML = `<img src="${base64}" style="width: 100%; height: 100%; object-fit: cover;">`;
                }
            });

            // Load base64 images from localStorage into service cells
            document.querySelectorAll('.service-image-preview-cell').forEach(el => {
                const id = el.getAttribute('data-service-id');
                const base64 = localStorage.getItem(`service_img_${id}`);
                if (base64) {
                    el.innerHTML = `<img src="${base64}" style="width: 100%; height: 100%; object-fit: cover;">`;
                }
            });

            // Interactive Revenue Chart Tooltip Logic
            $('svg circle').hover(function() {
                const cx = parseFloat($(this).attr('cx'));
                const cy = parseFloat($(this).attr('cy'));
                const val = $(this).attr('data-val');
                const day = $(this).attr('data-day');
                
                const tooltip = document.getElementById('chart-tooltip-group');
                if (tooltip && val && day) {
                    tooltip.setAttribute('transform', `translate(${cx - 45}, ${cy - 45})`);
                    tooltip.setAttribute('opacity', '1');
                    document.getElementById('tooltip-day').textContent = day;
                    document.getElementById('tooltip-val').textContent = val;
                }
            }, function() {
                const tooltip = document.getElementById('chart-tooltip-group');
                if (tooltip) {
                    tooltip.setAttribute('opacity', '0');

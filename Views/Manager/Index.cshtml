                                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" data-bs-dismiss="modal" style="font-size: 0.8rem; text-transform: none;">Hủy bỏ</button>
                                <button type="button" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold btn-confirm-action" style="font-size: 0.8rem; text-transform: none;">Đồng ý</button>
                            </div>
                        </div>
                    </div>
                `;
                document.body.appendChild(confirmModalEl);
            }

            confirmModalEl.querySelector('#adminConfirmTitle').innerText = title;
            confirmModalEl.querySelector('#adminConfirmMessage').innerHTML = message;
            
            const confirmBtn = confirmModalEl.querySelector('.btn-confirm-action');

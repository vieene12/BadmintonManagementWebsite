@section Scripts {
    <script>
        let addStaffModalObj = null;
        let promoteStaffModalObj = null;
        let adminEditCourtModalObj = null;
        let adminAddCourtModalObj = null;
        let adminAddServiceModalObj = null;
        let adminEditServiceModalObj = null;
        let adminCourtPrices = {
            @foreach (var court in ViewBag.Courts as List<AquarSmartCourt.Models.Court> ?? new List<AquarSmartCourt.Models.Court>())
            {
                @:@court.CourtId: @((int)court.HourlyPrice),
            }
        };

        $(document).ready(function() {
            addStaffModalObj = new bootstrap.Modal(document.getElementById('addStaffModal'));
            promoteStaffModalObj = new bootstrap.Modal(document.getElementById('promoteStaffModal'));
            adminEditCourtModalObj = new bootstrap.Modal(document.getElementById('adminEditCourtModal'));
            adminAddCourtModalObj = new bootstrap.Modal(document.getElementById('adminAddCourtModal'));
            adminAddServiceModalObj = new bootstrap.Modal(document.getElementById('adminAddServiceModal'));
            adminEditServiceModalObj = new bootstrap.Modal(document.getElementById('adminEditServiceModal'));

            // Interactive Revenue Chart Tooltip Logic
            $('svg circle').hover(function() {
                const cx = parseFloat($(this).attr('cx'));
                const cy = parseFloat($(this).attr('cy'));
                const val = $(this).attr('data-val');
                const day = $(this).attr('data-day');
                
                const tooltip = document.getElementById('chart-tooltip-group');
                if (tooltip && val && day) {
                    tooltip.setAttribute('transform', `translate(${cx - 45}, ${cy - 45})`);
                    tooltip.setAttribute('opacity', '1');
                    document.getElementById('tooltip-day').textContent = day;
                    document.getElementById('tooltip-val').textContent = val;
                }
            }, function() {
                const tooltip = document.getElementById('chart-tooltip-group');
                if (tooltip) {
                    tooltip.setAttribute('opacity', '0');
                }
            });
        });

        function openAddStaffModal() {
            $.ajax({
                url: '/api/StaffApi/next-code',
                type: 'GET',
                success: function(response) {
                    document.getElementById('staffCode').value = response.nextCode;
                },
                error: function() {
                    console.log('Không thể lấy mã nhân viên tiếp theo.');
                }
            });
            addStaffModalObj.show();
        }

        function openPromoteStaffModal() {
            $.ajax({
                url: '/api/StaffApi/next-code',
                type: 'GET',
                success: function(response) {
                    document.getElementById('promoteStaffCode').value = response.nextCode;
                },
                error: function() {
                    console.log('Không thể lấy mã nhân viên tiếp theo.');
                }
            });
            promoteStaffModalObj.show();
        }

        function processAddStaff(e) {
            e.preventDefault();
            const code = document.getElementById('staffCode').value;
            const name = document.getElementById('staffName').value;
            const birth = document.getElementById('staffBirth').value;
            const roleVal = document.getElementById('staffRole').value;
            const phone = document.getElementById('staffPhone').value;
            const user = document.getElementById('staffUser').value;
            const pass = document.getElementById('staffPass').value;

            const role = roleVal === 'Manager' ? 3 : 2;

            $.ajax({
                url: '/api/StaffApi',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    staffCode: code,
                    fullName: name,
                    dateOfBirth: birth,
                    role: role,
                    phoneNumber: phone,
                    username: user,
                    password: pass
                }),
                success: function(response) {
                    alert(response.message);
                    addStaffModalObj.hide();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi thêm nhân viên: ' + xhr.responseText);
                }
            });
        }

        function processPromoteStaff(e) {
            e.preventDefault();
            const userId = parseInt(document.getElementById('promoteUserId').value);
            const code = document.getElementById('promoteStaffCode').value;
            const birth = document.getElementById('promoteStaffBirth').value;
            const role = parseInt(document.getElementById('promoteStaffRole').value);

            $.ajax({
                url: '/api/StaffApi/promote',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    userId: userId,
                    staffCode: code,
                    dateOfBirth: birth,
                    role: role
                }),
                success: function(response) {
                    alert(response.message);
                    promoteStaffModalObj.hide();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi cấp quyền nhân viên: ' + xhr.responseText);
                }
            });
        }

        function demoteStaff(id) {
            if (!confirm('Bạn có chắc chắn muốn hủy quyền nhân sự của tài khoản này?')) {
                return;
            }

            $.ajax({
                url: `/api/StaffApi/demote/${id}`,
                type: 'POST',
                success: function(response) {
                    alert(response.message);
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi hủy quyền nhân viên: ' + xhr.responseText);
                }
            });
        }

        function openAdminEditCourtModal(id, currentName, fallbackPrice) {
            document.getElementById('adminEditCourtId').value = id;
            const nameVal = document.querySelector(`#admin-court-row-${id} .court-name-val`).innerText;
            const priceVal = adminCourtPrices[id] || fallbackPrice;
            document.getElementById('adminEditCourtName').value = nameVal;
            document.getElementById('adminEditCourtPrice').value = priceVal;
            adminEditCourtModalObj.show();
        }

        function saveAdminCourtConfig(e) {
            e.preventDefault();
            const id = document.getElementById('adminEditCourtId').value;
            const newName = document.getElementById('adminEditCourtName').value;
            const newPrice = parseInt(document.getElementById('adminEditCourtPrice').value);
            
            $.ajax({
                url: `/api/CourtApi/${id}`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({
                    courtId: parseInt(id),
                    courtName: newName,
                    hourlyPrice: newPrice
                }),
                success: function() {
                    adminCourtPrices[id] = newPrice;
                    document.querySelector(`#admin-court-row-${id} .court-name-val`).innerText = newName;
                    document.querySelector(`#admin-court-row-${id} .court-price-val`).innerText = `${newPrice.toLocaleString('vi-VN')}đ`;
                    
                    alert(`Cập nhật thông tin sân thành công!\nTên sân: ${newName}\nĐơn giá: ${newPrice.toLocaleString('vi-VN')}đ/giờ`);
                    adminEditCourtModalObj.hide();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi: ' + xhr.responseText);
                }
            });
        }

        function openAddCourtModal() {
            adminAddCourtModalObj.show();
        }

        function addNewCourt(e) {
            e.preventDefault();
            const code = document.getElementById('adminAddCourtId').value;
            const name = document.getElementById('adminAddCourtName').value;
            const price = parseInt(document.getElementById('adminAddCourtPrice').value);
            
            $.ajax({
                url: '/api/CourtApi',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    courtCode: code,
                    courtName: name,
                    hourlyPrice: price,
                    status: "Available"
                }),
                success: function(newCourt) {
                    alert(`Thêm mới sân con ${name} thành công!\nMã sân: ${code}\nGiá thuê: ${price.toLocaleString('vi-VN')}đ/giờ.`);
                    adminAddCourtModalObj.hide();
                    document.getElementById('adminAddCourtForm').reset();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi: ' + xhr.responseText);
                }
            });
        }

        // Accompanying Services Management functions
        function openAddServiceModal() {
            adminAddServiceModalObj.show();
        }

        function addNewService(e) {
            e.preventDefault();
            const name = document.getElementById('adminAddServiceName').value;
            const category = document.getElementById('adminAddServiceCategory').value;
            const unit = document.getElementById('adminAddServiceUnit').value;
            const price = parseFloat(document.getElementById('adminAddServicePrice').value);

            $.ajax({
                url: '/api/CourtApi/services',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    itemName: name,
                    category: category,
                    unit: unit,
                    unitPrice: price
                }),
                success: function(newService) {
                    alert(`Thêm mới dịch vụ "${name}" thành công!`);
                    adminAddServiceModalObj.hide();
                    document.getElementById('adminAddServiceForm').reset();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi khi thêm dịch vụ: ' + xhr.responseText);
                }
            });
        }

        function openAdminEditServiceModal(id, name, unit, price, category) {
            document.getElementById('adminEditServiceId').value = id;
            document.getElementById('adminEditServiceName').value = name;
            document.getElementById('adminEditServiceCategory').value = category || "Khác";
            document.getElementById('adminEditServiceUnit').value = unit;
            document.getElementById('adminEditServicePrice').value = price;
            adminEditServiceModalObj.show();
        }

        function saveAdminServiceConfig(e) {
            e.preventDefault();
            const id = document.getElementById('adminEditServiceId').value;
            const name = document.getElementById('adminEditServiceName').value;
            const category = document.getElementById('adminEditServiceCategory').value;
            const unit = document.getElementById('adminEditServiceUnit').value;
            const price = parseFloat(document.getElementById('adminEditServicePrice').value);

            $.ajax({
                url: `/api/CourtApi/services/${id}`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({
                    serviceItemId: parseInt(id),
                    itemName: name,
                    category: category,
                    unit: unit,
                    unitPrice: price
                }),
                success: function() {
                    alert(`Cập nhật dịch vụ "${name}" thành công!`);
                    adminEditServiceModalObj.hide();
                    location.reload();
                },
                error: function(xhr) {
                    alert('Lỗi khi cập nhật dịch vụ: ' + xhr.responseText);
                }
            });
        }

        function deleteServiceItem(id, name) {
            if (confirm(`Bạn có chắc chắn muốn xóa dịch vụ "${name}" không?`)) {
                $.ajax({
                    url: `/api/CourtApi/services/${id}`,
                    type: 'DELETE',
                    success: function() {
                        alert(`Đã xóa dịch vụ "${name}" thành công!`);
                        location.reload();
                    },
                    error: function(xhr) {
                        alert('Lỗi khi xóa dịch vụ: ' + xhr.responseText);
                    }
                });
            }
        }

        function filterAdminServicesTable() {
            const filterVal = document.getElementById('adminServiceCategoryFilter').value;
            const rows = document.querySelectorAll('.admin-service-row');
            rows.forEach(row => {
                const cat = row.getAttribute('data-category');
                if (filterVal === "All" || cat === filterVal) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
}

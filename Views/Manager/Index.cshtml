@{
    ViewData["Title"] = "Ban Quản Lý - Quản Trị Hệ Thống";
    ViewData["ActivePage"] = "Manager";
}

<div class="container-fluid px-0">
    <!-- Header Administrative Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark" style="letter-spacing: -1px;"><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Hệ Thống Quản Trị (Admin Panel)</h2>
            <p class="text-secondary mb-0">Theo dõi doanh thu kinh doanh chuyên sâu, kiểm soát bảo mật nhân sự và cấu hình sân.</p>
        </div>
        <div class="d-flex gap-2">
            <button id="btn-export-report" class="btn btn-export-report rounded-pill px-4 shadow-sm" onclick="handleExportExcel()">
                <i class="bi bi-download me-1"></i> Xuất Báo Cáo
            </button>
            <button class="btn btn-outline-secondary rounded-pill px-3" onclick="location.reload()" style="background: white;">
                <i class="bi bi-arrow-clockwise"></i> Làm Mới Dữ Liệu
            </button>
        </div>
    </div>

    <div id="tab-overview" class="admin-tab-content active">
        <!-- KPI Summary Row -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="glass-card p-3 bg-white d-flex align-items-center gap-3 border-start border-4 border-primary glow-card kpi-card">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle" style="font-size: 1.5rem; line-height: 1;">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">Doanh thu hôm nay</small>
                        <div class="kpi-num">4.850.000đ</div>
                        <span class="text-success small fw-bold"><i class="bi bi-arrow-up-short"></i> +12% hôm qua</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="glass-card p-3 bg-white d-flex align-items-center gap-3 border-start border-4 border-success glow-card kpi-card">
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle" style="font-size: 1.5rem; line-height: 1;">
                        <i class="bi bi-percent"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">Công suất khai thác</small>
                        <div class="kpi-num">82.5%</div>
                        <span class="text-success small fw-bold"><i class="bi bi-arrow-up-short"></i> +4.2% tuần trước</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="glass-card p-3 bg-white d-flex align-items-center gap-3 border-start border-4 border-info glow-card kpi-card">
                    <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle" style="font-size: 1.5rem; line-height: 1;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">Tổng giờ chơi ca</small>
                        <div class="kpi-num">26.5 giờ</div>
                        <span class="text-secondary small fw-medium">Đang hoạt động hôm nay</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="glass-card p-3 bg-white d-flex align-items-center gap-3 border-start border-4 border-warning glow-card kpi-card">
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle" style="font-size: 1.5rem; line-height: 1;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">Nhân sự ca trực</small>
                        <div class="kpi-num">2 Lễ Tân</div>
                        <span class="text-secondary small fw-medium">Hệ thống vận hành an toàn</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Chart mock -->
        <div class="glass-card p-4 bg-white glow-card">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                    <h5 class="fw-bold text-dark mb-0" style="font-weight: 800;"><i class="bi bi-bar-chart-line-fill me-2 text-primary"></i>Biểu Đồ Doanh Thu Tuần</h5>
                    <select class="form-select form-select-sm w-auto">
                        <option>7 Ngày qua (Tuần này)</option>
                        <option>Tháng này</option>
                    </select>
                </div>
                <!-- Simulated SVG chart for elegant visuals -->
                <div class="p-3 border rounded-4 bg-light text-center position-relative" style="height: 250px; overflow: visible;">
                    <svg viewBox="0 0 600 200" class="w-100 h-100" style="overflow: visible;">
                        <defs>
                            <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#4f46e5" stop-opacity="0.3"/>
                                <stop offset="100%" stop-color="#4f46e5" stop-opacity="0.0"/>
                            </linearGradient>
                        </defs>
                        <!-- Grid lines -->
                        <line x1="40" y1="20" x2="560" y2="20" stroke="#e2e8f0" stroke-dasharray="4"/>
                        <line x1="40" y1="70" x2="560" y2="70" stroke="#e2e8f0" stroke-dasharray="4"/>
                        <line x1="40" y1="120" x2="560" y2="120" stroke="#e2e8f0" stroke-dasharray="4"/>
                        <line x1="40" y1="170" x2="560" y2="170" stroke="#cbd5e1" stroke-width="1.5"/>
                        
                        <!-- Area Chart path -->
                        <path class="chart-area-path" d="M 50 170 L 120 110 L 190 130 L 260 80 L 330 90 L 400 50 L 470 60 L 540 40 L 540 170 Z" fill="url(#chartGrad)"/>
                        
                        <!-- Line Chart path -->
                        <path class="chart-line-path" d="M 50 170 L 120 110 L 190 130 L 260 80 L 330 90 L 400 50 L 470 60 L 540 40" fill="none" stroke="#4f46e5" stroke-width="3" stroke-linecap="round"/>
                        
                        <!-- Points and Tooltips with custom data attributes -->
                        <circle cx="50" cy="170" r="5.5" fill="#4f46e5" stroke="#fff" stroke-width="2" data-val="250.000đ" data-day="Thứ 2"/>
                        <circle cx="120" cy="110" r="5.5" fill="#4f46e5" stroke="#fff" stroke-width="2" data-val="650.000đ" data-day="Thứ 3"/>
                        <circle cx="190" cy="130" r="5.5" fill="#4f46e5" stroke="#fff" stroke-width="2" data-val="550.000đ" data-day="Thứ 4"/>
                        <circle cx="260" cy="80" r="5.5" fill="#4f46e5" stroke="#fff" stroke-width="2" data-val="900.000đ" data-day="Thứ 5"/>
                        <circle cx="330" cy="90" r="5.5" fill="#4f46e5" stroke="#fff" stroke-width="2" data-val="820.000đ" data-day="Thứ 6"/>
                        <circle cx="400" cy="50" r="5.5" fill="#4f46e5" stroke="#fff" stroke-width="2" data-val="1.250.000đ" data-day="Thứ 7"/>
                        <circle cx="470" cy="60" r="5.5" fill="#4f46e5" stroke="#fff" stroke-width="2" data-val="1.100.000đ" data-day="Chủ Nhật"/>
                        <circle cx="540" cy="40" r="6.5" fill="#10b981" stroke="#fff" stroke-width="2.5" data-val="1.450.000đ" data-day="Hôm nay"/>
                        
                        <!-- X-Axis Labels -->
                        <text x="50" y="190" font-size="10" fill="#64748b" text-anchor="middle" font-weight="600">T2</text>
                        <text x="120" y="190" font-size="10" fill="#64748b" text-anchor="middle" font-weight="600">T3</text>
                        <text x="190" y="190" font-size="10" fill="#64748b" text-anchor="middle" font-weight="600">T4</text>
                        <text x="260" y="190" font-size="10" fill="#64748b" text-anchor="middle" font-weight="600">T5</text>
                        <text x="330" y="190" font-size="10" fill="#64748b" text-anchor="middle" font-weight="600">T6</text>
                        <text x="400" y="190" font-size="10" fill="#64748b" text-anchor="middle" font-weight="600">T7</text>
                        <text x="470" y="190" font-size="10" fill="#64748b" text-anchor="middle" font-weight="600">CN</text>
                        <text x="540" y="190" font-size="10" fill="#10b981" text-anchor="middle" font-weight="800">Hôm nay</text>

                        <!-- Dynamic Tooltip Element inside SVG -->
                        <g id="chart-tooltip-group" opacity="0" style="transition: opacity 0.15s ease-out; pointer-events: none;">
                            <rect width="90" height="34" rx="6" fill="#0f172a" />
                            <text id="tooltip-day" x="45" y="13" font-size="8" fill="#94a3b8" text-anchor="middle" font-weight="600">Thứ 7</text>
                            <text id="tooltip-val" x="45" y="25" font-size="10" fill="#34d399" text-anchor="middle" font-weight="800">1.250.000đ</text>
                        </g>
                    </svg>
                </div>
        </div>
    </div> <!-- end tab-overview -->

    <!-- Tab: Courts -->
    <div id="tab-courts" class="admin-tab-content">
        <!-- Court Catalog Management Card -->
        <div class="glass-card p-4 bg-white mt-0 glow-card">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <h5 class="fw-bold text-dark mb-0" style="font-weight: 800;"><i class="bi bi-grid-3x3-gap-fill me-2 text-primary"></i>Danh Mục Sân Con</h5>
                    <button class="btn btn-primary btn-sm px-4 rounded-pill shadow-sm" onclick="openAddCourtModal()"><i class="bi bi-plus-circle me-1"></i>Thêm Sân Mới</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle small mb-0" id="admin-courts-table">
                        <thead>
                            <tr>
                                <th>Ảnh</th>
                                <th>Mã Sân</th>
                                <th>Tên Sân</th>
                                <th class="text-end">Giá Thuê / Giờ</th>
                                <th class="text-center">Trạng Thái</th>
                                <th class="text-center">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var court in ViewBag.Courts as List<AquarSmartCourt.Models.Court> ?? new List<AquarSmartCourt.Models.Court>())
                            {
                                var now = DateTime.Now;
                                var activeBooking = (ViewBag.TodayBookings as List<AquarSmartCourt.Models.Booking>)?.FirstOrDefault(b => 
                                    b.CourtId == court.CourtId && 
                                    b.StartTime <= now && 
                                    now <= b.EndTime
                                );

                                string computedStatus = court.Status;
                                if (court.Status == "Available" && activeBooking != null)
                                {
                                    computedStatus = "InUse";
                                }

                                string statusBadge = computedStatus.ToLower() switch
                                {
                                    "inuse" => "<span class='status-badge in-use'>Đang sử dụng</span>",
                                    "available" => "<span class='status-badge available'>Đang trống</span>",
                                    "maintenance" => "<span class='status-badge maintenance'>Bảo trì</span>",
                                    _ => "<span class='status-badge available'>Đang trống</span>"
                                };

                                <tr id="admin-court-row-@court.CourtId">
                                    <td>
                                        <div class="court-image-preview-cell" data-court-id="@court.CourtId" style="width: 50px; height: 35px; background: #e2e8f0; border-radius: 2px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-image text-muted" style="font-size: 1rem;"></i>
                                        </div>
                                    </td>
                                    <td><strong>@court.CourtCode</strong></td>
                                    <td class="fw-bold text-dark court-name-val">@court.CourtName</td>
                                    <td class="text-end fw-bold text-dark court-price-val">@(((int)court.HourlyPrice).ToString("N0", new System.Globalization.CultureInfo("vi-VN")))đ</td>
                                    <td class="text-center">
                                        @Html.Raw(statusBadge)
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <button class="btn btn-outline-primary btn-sm py-1 px-3" onclick="openAdminEditCourtModal(@court.CourtId, '@court.CourtName', @((int)court.HourlyPrice), '@court.Status')" style="border-radius: 2px !important; font-size: 0.8rem;"><i class="bi bi-pencil"></i> Sửa</button>
                                            <button class="btn btn-outline-secondary btn-sm py-1 px-3" onclick="openUploadImageModal('court', @court.CourtId, '@court.CourtName')" style="border-radius: 2px !important; font-size: 0.8rem;"><i class="bi bi-image"></i> Ảnh</button>
                                            <button class="btn btn-outline-danger btn-sm py-1 px-3" onclick="deleteCourtItem(@court.CourtId, '@court.CourtName')" style="border-radius: 2px !important; font-size: 0.8rem;"><i class="bi bi-trash"></i> Xóa</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
        </div>
    </div> <!-- end tab-courts -->

    <!-- Tab: Services -->
    <div id="tab-services" class="admin-tab-content">
        <!-- Accompanying Services Management Card -->
        <div class="glass-card p-4 bg-white mt-0 glow-card">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <h5 class="fw-bold text-dark mb-0" style="font-weight: 800;"><i class="bi bi-tags-fill me-2 text-primary"></i>Danh Mục Dịch Vụ Đi Kèm</h5>
                    <div class="d-flex gap-2">
                        <select class="form-select form-select-sm rounded-pill px-3" id="adminServiceCategoryFilter" onchange="filterAdminServicesTable()" style="width: 160px; font-size: 0.8rem; border: 1px solid #e2e8f0;">
                            <option value="All">Tất cả danh mục</option>
                            <option value="Nước uống">Nước uống</option>
                            <option value="Thuê vợt">Thuê vợt</option>
                            <option value="Phụ kiện">Phụ kiện</option>
                        </select>
                        <button class="btn btn-primary btn-sm px-4 rounded-pill shadow-sm" onclick="openAddServiceModal()"><i class="bi bi-plus-circle me-1"></i>Thêm Dịch Vụ Mới</button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle small mb-0" id="admin-services-table">
                        <thead>
                            <tr>
                                <th>Ảnh</th>
                                <th>Tên Dịch Vụ</th>
                                <th class="text-center">Danh Mục</th>
                                <th class="text-center">Đơn Vị Tính</th>
                                <th class="text-end">Đơn Giá</th>
                                <th class="text-center">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.Services as List<AquarSmartCourt.Models.ServiceItem> ?? new List<AquarSmartCourt.Models.ServiceItem>())
                            {
                                <tr id="admin-service-row-@item.ServiceItemId" class="admin-service-row" data-category="@item.Category">
                                    <td>
                                        <div class="service-image-preview-cell" data-service-id="@item.ServiceItemId" style="width: 50px; height: 35px; background: #e2e8f0; border-radius: 2px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-image text-muted" style="font-size: 1rem;"></i>
                                        </div>
                                    </td>
                                    <td class="fw-bold text-dark service-name-val">@item.ItemName</td>
                                    <td class="text-center"><span class="badge bg-light text-dark border service-category-val">@item.Category</span></td>
                                    <td class="text-center service-unit-val">@item.Unit</td>
                                    <td class="text-end fw-bold text-primary service-price-val">@(((int)item.UnitPrice).ToString("N0", new System.Globalization.CultureInfo("vi-VN")))đ</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <button class="btn btn-outline-primary btn-sm py-1 px-3" onclick="openAdminEditServiceModal(@item.ServiceItemId, '@item.ItemName', '@item.Unit', @((int)item.UnitPrice), '@item.Category')" style="border-radius: 2px !important; font-size: 0.8rem;"><i class="bi bi-pencil"></i> Sửa</button>
                                            <button class="btn btn-outline-secondary btn-sm py-1 px-3" onclick="openUploadImageModal('service', @item.ServiceItemId, '@item.ItemName')" style="border-radius: 2px !important; font-size: 0.8rem;"><i class="bi bi-image"></i> Ảnh</button>
                                            <button class="btn btn-outline-danger btn-sm py-1 px-3" onclick="deleteServiceItem(@item.ServiceItemId, '@item.ItemName')" style="border-radius: 2px !important; font-size: 0.8rem;"><i class="bi bi-trash"></i> Xóa</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
        </div>
    </div> <!-- end tab-services -->

    <!-- Tab: Staff -->
    <div id="tab-staff" class="admin-tab-content">
        <!-- Security and Staff Management -->
        <div class="glass-card p-4 bg-white mt-0 glow-card">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <h5 class="fw-bold text-dark mb-0" style="font-weight: 800;"><i class="bi bi-shield-lock-fill me-2 text-primary"></i>Nhân Sự Hệ Thống</h5>
                    <div class="d-flex gap-1">
                        <button class="btn btn-outline-success btn-sm px-2" onclick="openPromoteStaffModal()" title="Cấp quyền nhân viên từ User" style="font-size: 0.75rem; border-radius: 2px !important;">
                            <i class="bi bi-arrow-up-circle-fill me-1"></i> Cấp quyền
                        </button>
                        <button class="btn btn-outline-primary btn-sm" onclick="openAddStaffModal()" title="Thêm nhân sự mới" style="width: 32px; height: 32px; padding: 0; border-radius: 2px !important;">
                            <i class="bi bi-person-plus-fill"></i>
                        </button>
                    </div>
                </div>
                <div class="vstack gap-3" id="staff-list-container">
                    @foreach (var staff in ViewBag.Staffs as List<AquarSmartCourt.Models.User> ?? new List<AquarSmartCourt.Models.User>())
                    {
                        var firstLetter = string.IsNullOrEmpty(staff.FullName) ? "U" : staff.FullName.Trim().Substring(0, 1).ToUpper();
                        var isOwner = staff.Username == "manager" || (staff.Role == 3 && staff.StaffCode == "AD001");
                        var cardBg = isOwner ? "background: rgba(99, 102, 241, 0.03);" : "";
                        var cardBorder = isOwner ? "border-primary border-opacity-25" : "";
                        var avatarBg = isOwner ? "rgba(244, 63, 94, 0.1)" : "rgba(99, 102, 241, 0.1)";
                        var avatarColor = isOwner ? "text-danger" : "text-primary";
                        var roleBadgeClass = staff.Role == 3 ? "bg-dark text-white" : "bg-primary bg-opacity-10 text-primary";
                        var roleName = staff.Role == 3 ? "Quản lý" : "Lễ tân";
                        var statusText = isOwner ? "Chủ sở hữu" : (staff.IsActive ? "Hoạt động" : "Tạm khóa");
                        var statusBadgeStyle = isOwner ? "background: hsla(var(--primary-hsl), 0.1); color: var(--primary-color); border-color: hsla(var(--primary-hsl), 0.2);" : "";

                        <div class="border rounded-4 p-3 d-flex justify-content-between align-items-center glow-card @cardBorder" style="@cardBg">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-img @avatarColor fw-bold" style="background-color: @avatarBg; width: 42px; height: 42px; font-size: 0.95rem; display: flex; align-items: center; justify-content: center; border-radius: 50%; margin-left: 0;">@firstLetter</div>
                                <div>
                                    <div class="fw-bold text-dark mb-0">@staff.FullName</div>
                                    <small class="text-secondary d-block">Mã NV: <strong class="text-dark">@staff.StaffCode</strong></small>
                                    <span class="badge @roleBadgeClass mt-1" style="font-size: 0.65rem; @(staff.Role == 3 ? "background-color: #0f172a !important;" : "")">@roleName</span>
                                </div>
                            </div>
                            <div class="text-end d-flex align-items-center gap-2">
                                <span class="status-badge available" style="font-size: 0.65rem; @statusBadgeStyle">@statusText</span>
                                @if (!isOwner)
                                {
                                    <button class="btn btn-link text-danger p-0 border-0 bg-transparent" onclick="demoteStaff(@staff.UserId)" title="Hủy quyền nhân sự" style="line-height: 1;">
                                        <i class="bi bi-person-dash-fill fs-5"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
        </div>
    </div> <!-- end tab-staff -->

    <!-- Tab: Camera -->
    <div id="tab-camera" class="admin-tab-content">
        <!-- Active surveillance list -->
        <div class="glass-card p-4 bg-white mt-0 glow-card">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-camera-video-fill me-2 text-danger"></i>Kho Lưu Trữ Camera Giám Sát Sân Con</h5>
        <div class="table-responsive">
            <table class="table table-hover table-custom align-middle small mb-0">
                <thead>
                    <tr>
                        <th>Mã Video</th>
                        <th>Vị Trí Sân</th>
                        <th>Thời Gian Ghi Hình</th>
                        <th>Khách Hàng Đăng Ký</th>
                        <th>Trạng Thái Bản Ghi</th>
                        <th>Thao Tác File</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>CAM_VID_1092</strong></td>
                        <td><span class="badge bg-light text-dark border">Sân Con 01</span></td>
                        <td>08/06/2026 17:00 - 19:00</td>
                        <td>Nguyễn Văn A (0987654321)</td>
                        <td><span class="badge bg-info bg-opacity-12 text-info fw-bold">Chờ khách xác nhận</span></td>
                        <td>
                            <button class="btn btn-xs btn-outline-primary py-1 px-3 rounded-pill" onclick="alert('Đang tải xuống tệp tin gốc MP4... (Dung lượng: 840MB)')">
                                <i class="bi bi-download me-1"></i> Tải file gốc
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>CAM_VID_1091</strong></td>
                        <td><span class="badge bg-light text-dark border">Sân Con 03</span></td>
                        <td>08/06/2026 18:00 - 20:00</td>
                        <td>Trần Minh (0912345678)</td>
                        <td><span class="badge bg-success bg-opacity-12 text-success fw-bold">Đã lưu trữ (Saved)</span></td>
                        <td>
                            <button class="btn btn-xs btn-outline-primary py-1 px-3 rounded-pill" onclick="alert('Đang tải xuống tệp tin gốc MP4... (Dung lượng: 920MB)')">
                                <i class="bi bi-download me-1"></i> Tải file gốc
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>CAM_VID_1090</strong></td>
                        <td><span class="badge bg-light text-dark border">Sân Con 02</span></td>
                        <td>07/06/2026 20:00 - 21:00</td>
